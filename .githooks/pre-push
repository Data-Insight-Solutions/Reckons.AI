#!/usr/bin/env bash
# F273 phase A: run the blocking script-tier jobs (the same ones CI blocks on) before the push.
# To skip once, deliberately: git push --no-verify (CI will still run them).
ROOT="${RECKONS_ROOT:-$(git rev-parse --show-toplevel)}"
out="$(npx --no-install tsx "$ROOT/scripts/offline/run-all.ts" --blocking --ci --no-gpu-gate 2>&1)"
if [ $? -ne 0 ]; then
  echo "$out" | grep -E '✗|BLOCKING' >&2
  echo "pre-push: a blocking check failed (named above). Run 'npx tsx scripts/offline/run-all.ts --blocking --ci' to see the output, fix it, push again." >&2
  exit 1
fi
