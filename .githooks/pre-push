#!/usr/bin/env bash
# Run the checks that can fail CI before the push leaves this machine (about 10 seconds).
# On 2026-10-27 four blocking checks failed in CI twelve minutes after a push; every one of them
# runs locally. Opt in with `npm run hooks:install`; skip once with `git push --no-verify`.
set -e
cd "$(git rev-parse --show-toplevel)"
if ! npm run -s check:blocking >/tmp/reckons-pre-push.log 2>&1; then
  grep -E "FAIL|✗|BLOCKING" /tmp/reckons-pre-push.log | head -20
  echo "pre-push: a blocking check failed (full log: /tmp/reckons-pre-push.log). Fix it, or push with --no-verify."
  exit 1
fi
