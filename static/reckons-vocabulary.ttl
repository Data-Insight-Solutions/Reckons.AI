@prefix kb:     <urn:kbase:concept/> .
@prefix kpred:  <urn:kbase:predicate/> .
@prefix kmeta:  <urn:kbase:meta/> .
@prefix ktype:  <urn:kbase:type/> .
@prefix kalt:   <urn:kbase:type/altitude/> .
@prefix ktask:  <urn:kbase:type/task-state/> .
@prefix kstat:  <urn:kbase:type/review-status/> .
@prefix klife:  <urn:kbase:type/lifecycle/> .
@prefix kprio:  <urn:kbase:priority/> .
@prefix kset:   <urn:kbase:type/set-kind/> .
@prefix klayer: <urn:kbase:type/layer/> .
@prefix kshape: <urn:kbase:shape/> .
@prefix hnav:   <urn:reckons:nav/> .
@prefix rdf:    <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:   <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos:   <http://www.w3.org/2004/02/skos/core#> .
@prefix sh:     <http://www.w3.org/ns/shacl#> .
@prefix xsd:    <http://www.w3.org/2001/XMLSchema#> .
@prefix dcterms: <http://purl.org/dc/terms/> .

# =============================================================================
# THE CLOSED VOCABULARIES OF RECKONS.AI, AS SKOS AND SHACL
# =============================================================================
#
# Matt, 2026-08-28: "We need to work on defined with SKOS and SHACL then... We want a strong
# foundation, and a place to look for refinement (W3C)."
#
# WHY THIS FILE EXISTS. Four vocabularies in this product are CLOSED SETS — altitude, task state,
# review status, feature lifecycle — and all four were free-text literals. kb:feature-lifecycle-vocab
# (F75.2) ruled years of sessions ago that a closed set belongs in a SKOS scheme referenced by IRI,
# "so an invalid status is a broken reference that graph-lint catches structurally". It was never
# built, and F149 found the same mistake being repeated the day it was written down.
#
# SKOS:NOTATION IS THE BRIDGE, AND IT IS WHY THIS CAN LAND TODAY. The standard way to attach a
# machine code to a concept is `skos:notation`, so every concept below carries the exact literal
# the code writes right now. That makes this file immediately enforceable — graph-lint can check
# a literal against the notations — WITHOUT a breaking migration of every graph to IRIs. Moving
# the writers from literals to IRIs is a later, separate step; the vocabulary does not have to
# wait for it.
#
# WHAT IS HONEST ABOUT THE STATE OF THIS. Defining a vocabulary is not using one. As of writing,
# NO application code reads this file. graph-lint validates against it, which is real enforcement
# and the reason it is not merely decorative — but do not read this file as "Reckons.AI is defined
# with SKOS and SHACL". It is the foundation for that claim, not the claim.
#
# WHERE TO LOOK FOR REFINEMENT — the W3C specs these follow:
#   SKOS   https://www.w3.org/TR/skos-reference/     concept schemes, notation, ordered collections
#   SHACL  https://www.w3.org/TR/shacl/              node and property shapes, sh:in, severity
#   RDFS   https://www.w3.org/TR/rdf-schema/         rdfs:domain / rdfs:range
#   PROV-O https://www.w3.org/TR/prov-o/             provenance — already partially adopted

<urn:kbase:vocabulary/reckons> a skos:ConceptScheme ;
    dcterms:title "Reckons.AI controlled vocabularies" ;
    dcterms:modified "2026-08-28"^^xsd:date ;
    skos:definition "The closed sets this product's own predicates draw from. Each concept carries a skos:notation matching the literal the code writes today." .

# ── ALTITUDE (F139) ──────────────────────────────────────────────────────────
# An ORDERED scale, so it is a skos:OrderedCollection as well as a scheme. The order is the
# review tree's depth and the detail ladder's rungs; hnav:order carries it in this project's
# own convention, skos:memberList carries it in the standard's.

ktype:AltitudeScheme a skos:ConceptScheme ;
    rdfs:label "Fact altitude" ;
    skos:definition "How much a fact matters, tested by consequence: if this fact were wrong, what would we do differently?" ;
    skos:note "The discriminating question is about being WRONG, not about being interesting. Framing it as consequence rather than importance is what makes it decidable by a script instead of by taste." ;
    skos:hasTopConcept kalt:decision, kalt:judgment, kalt:evidence, kalt:record, kalt:log .

ktype:AltitudeOrder a skos:OrderedCollection ;
    rdfs:label "Altitude, highest to lowest" ;
    skos:memberList ( kalt:decision kalt:judgment kalt:evidence kalt:record kalt:log ) .

kalt:decision a skos:Concept ;
    skos:inScheme ktype:AltitudeScheme ;
    skos:prefLabel "Decision" ;
    skos:notation "decision" ;
    skos:definition "It forecloses options. If it were wrong, we go the wrong direction." ;
    hnav:order 4 .

kalt:judgment a skos:Concept ;
    skos:inScheme ktype:AltitudeScheme ;
    skos:prefLabel "Judgment" ;
    skos:notation "judgment" ;
    skos:definition "A verdict no check can settle. If it were wrong, we believe something untrue about whether the thing is any good." ;
    skos:note "The fail-upward default: an unclassified predicate lands here, because guessing `log` would HIDE a real decision." ;
    hnav:order 3 .

kalt:evidence a skos:Concept ;
    skos:inScheme ktype:AltitudeScheme ;
    skos:prefLabel "Evidence" ;
    skos:notation "evidence" ;
    skos:definition "A measurement under a judgment. If it were wrong, a judgment above it loses its footing." ;
    hnav:order 2 .

kalt:record a skos:Concept ;
    skos:inScheme ktype:AltitudeScheme ;
    skos:prefLabel "Record" ;
    skos:notation "record" ;
    skos:definition "Mechanical; a script settles it. If it were wrong, a link needs fixing." ;
    skos:note "Not reviewable BY A PERSON — this is F88's machine lane — but still reviewable in principle." ;
    hnav:order 1 .

kalt:log a skos:Concept ;
    skos:inScheme ktype:AltitudeScheme ;
    skos:prefLabel "Log" ;
    skos:notation "log" ;
    skos:definition "It asserts only that something happened. If it were wrong: nothing — there is no claim in it to be wrong about." ;
    skos:note "CLASSIFIED, NEVER DROPPED. A log contradicting the evidence under a live decision IS a deciding factor, which is why altitude is a view-time rank rather than a delete." ;
    hnav:order 0 .

# ── TASK STATE (F87) ─────────────────────────────────────────────────────────

ktype:TaskStateScheme a skos:ConceptScheme ;
    rdfs:label "Agent task state" ;
    skos:definition "Where a task is in its life. Not an ordered scale — a state machine." ;
    skos:hasTopConcept ktask:proposed, ktask:open, ktask:claimed, ktask:waiting, ktask:done, ktask:failed .

ktask:proposed a skos:Concept ;
    skos:inScheme ktype:TaskStateScheme ;
    skos:prefLabel "Proposed" ;
    skos:notation "proposed" ;
    skos:definition "Read out of a dictated note; nobody has authored it. Carries a goal in the speaker's own words and nothing else." ;
    skos:note "Can never be assigned: a transcript cannot contain the effects a task may have or how a machine would know it worked." .

ktask:open a skos:Concept ;
    skos:inScheme ktype:TaskStateScheme ;
    skos:prefLabel "Open" ;
    skos:notation "open" ;
    skos:definition "A person wrote this task down and meant it. Available for a runner to claim." .

ktask:claimed a skos:Concept ;
    skos:inScheme ktype:TaskStateScheme ;
    skos:prefLabel "Claimed" ;
    skos:notation "claimed" ;
    skos:definition "A runner holds a LEASE on it — not a lock. A runner that dies must not hold a task forever." .

ktask:waiting a skos:Concept ;
    skos:inScheme ktype:TaskStateScheme ;
    skos:prefLabel "Waiting" ;
    skos:notation "waiting" ;
    skos:definition "Started, and blocked on something outside itself." .

ktask:done a skos:Concept ;
    skos:inScheme ktype:TaskStateScheme ;
    skos:prefLabel "Done" ;
    skos:notation "done" ;
    skos:definition "Finished, with an outcome recorded and independently verified by its own done-when." .

ktask:failed a skos:Concept ;
    skos:inScheme ktype:TaskStateScheme ;
    skos:prefLabel "Failed" ;
    skos:notation "failed" ;
    skos:definition "Ended without success, with an outcome recorded. 'I did nothing, and here is why' is a legitimate outcome; silence is not." .

# ── REVIEW STATUS ────────────────────────────────────────────────────────────

ktype:ReviewStatusScheme a skos:ConceptScheme ;
    rdfs:label "Statement review status" ;
    skos:definition "Whether a human has settled a fact, and how." ;
    skos:hasTopConcept kstat:pending, kstat:pending-removal, kstat:confirmed, kstat:refined, kstat:rejected, kstat:superseded .

kstat:pending a skos:Concept ;
    skos:inScheme ktype:ReviewStatusScheme ; skos:prefLabel "Pending" ; skos:notation "pending" ;
    skos:definition "Proposed and awaiting a human decision." .
kstat:pending-removal a skos:Concept ;
    skos:inScheme ktype:ReviewStatusScheme ; skos:prefLabel "Pending removal" ; skos:notation "pending-removal" ;
    skos:definition "A deletion has been proposed and awaits confirmation." .
kstat:confirmed a skos:Concept ;
    skos:inScheme ktype:ReviewStatusScheme ; skos:prefLabel "Confirmed" ; skos:notation "confirmed" ;
    skos:definition "Approved by a human, or settled by a deterministic check that names itself." .
kstat:refined a skos:Concept ;
    skos:inScheme ktype:ReviewStatusScheme ; skos:prefLabel "Refined" ; skos:notation "refined" ;
    skos:definition "Edited by a human, replacing a pending variant." .
kstat:rejected a skos:Concept ;
    skos:inScheme ktype:ReviewStatusScheme ; skos:prefLabel "Rejected" ; skos:notation "rejected" ;
    skos:definition "Turned down. Retained rather than deleted, so the same proposal is not asked again." .
kstat:superseded a skos:Concept ;
    skos:inScheme ktype:ReviewStatusScheme ; skos:prefLabel "Superseded" ; skos:notation "superseded" ;
    skos:definition "Replaced by a newer statement." .

# ── FEATURE LIFECYCLE (F75.2, specified 2026-07-12 and unbuilt until now) ─────

ktype:FeatureLifecycle a skos:ConceptScheme ;
    rdfs:label "Feature lifecycle" ;
    skos:definition "How far a feature has actually got. A feature is not `functional` because we wish it were." ;
    skos:hasTopConcept klife:speculative, klife:planned, klife:in-progress, klife:scaffolded, klife:functional, klife:production .

ktype:FeatureLifecycleOrder a skos:OrderedCollection ;
    rdfs:label "Lifecycle, earliest to latest" ;
    skos:memberList ( klife:speculative klife:planned klife:in-progress klife:scaffolded klife:functional klife:production ) .

klife:speculative a skos:Concept ;
    skos:inScheme ktype:FeatureLifecycle ; skos:prefLabel "Speculative" ; skos:notation "speculative" ;
    skos:definition "An idea worth recording. Nobody has committed to it." ; hnav:order 0 .
klife:planned a skos:Concept ;
    skos:inScheme ktype:FeatureLifecycle ; skos:prefLabel "Planned" ; skos:notation "planned" ;
    skos:definition "Committed to and designed. No code." ; hnav:order 1 .
# DE-FACTO, AND RECORDED BECAUSE IT IS REAL. `in-progress` was never in the designed lifecycle;
# it appears on 14 features and graph-lint has always accepted it. A vocabulary that omitted a
# value the corpus actually uses would be describing a wish, and the first thing it would do is
# fail 14 valid entities. Either promote it deliberately or migrate those 14 — but not by
# pretending here.
klife:in-progress a skos:Concept ;
    skos:inScheme ktype:FeatureLifecycle ; skos:prefLabel "In progress" ; skos:notation "in-progress" ;
    skos:definition "Started, and not yet whole. Sits between planned and scaffolded." ;
    skos:note "De-facto rather than designed. 14 uses as of 2026-08-28." ; hnav:order 2 .

klife:scaffolded a skos:Concept ;
    skos:inScheme ktype:FeatureLifecycle ; skos:prefLabel "Scaffolded" ; skos:notation "scaffolded" ;
    skos:definition "Parts exist and are tested; the feature does not yet work end to end." ; hnav:order 3 .
klife:functional a skos:Concept ;
    skos:inScheme ktype:FeatureLifecycle ; skos:prefLabel "Functional" ; skos:notation "functional" ;
    skos:definition "Works end to end for its stated case, and has been demonstrated doing so." ; hnav:order 4 .
klife:production a skos:Concept ;
    skos:inScheme ktype:FeatureLifecycle ; skos:prefLabel "Production" ; skos:notation "production" ;
    skos:definition "Deployed, used, and carrying its own failures visibly." ; hnav:order 5 .

# =============================================================================
# SHACL — what a well-formed use of these predicates looks like
# =============================================================================
#
# sh:in over the NOTATIONS rather than the concept IRIs, deliberately: it constrains the data as
# it exists TODAY. When the writers move to IRIs, each sh:in becomes an sh:class on the scheme and
# the shapes get simpler, not more complex. Severity is Violation for the closed sets — an unknown
# value is not a matter of taste.

kshape:Altitude a sh:NodeShape ;
    rdfs:label "Altitude values must come from the scheme" ;
    sh:targetSubjectsOf kpred:altitude ;
    sh:property [
        sh:path kpred:altitude ;
        sh:in ( "decision" "judgment" "evidence" "record" "log" ) ;
        sh:maxCount 1 ;
        sh:severity sh:Violation ;
        sh:message "kpred:altitude must be one of the ktype:AltitudeScheme notations."
    ] .

kshape:TaskState a sh:NodeShape ;
    rdfs:label "A task's state must come from the scheme" ;
    sh:targetClass ktype:AgentTask ;
    sh:property [
        sh:path kpred:task-state ;
        sh:in ( "proposed" "open" "claimed" "waiting" "done" "failed" ) ;
        sh:maxCount 1 ;
        sh:severity sh:Violation ;
        sh:message "kpred:task-state must be one of the ktype:TaskStateScheme notations."
    ] ;
    sh:property [
        sh:path kpred:goal ;
        sh:minCount 1 ;
        sh:severity sh:Violation ;
        sh:message "A task without a goal has nothing to do."
    ] ;
    sh:property [
        sh:path kpred:effect ;
        sh:in ( "read-only" "queue-write" "source-write" "external-read" "external-write" ) ;
        sh:severity sh:Violation ;
        sh:message "An effect declaration is an authority boundary; an unknown one must block, not pass."
    ] .

kshape:FeatureStatus a sh:NodeShape ;
    rdfs:label "A feature's status must come from the lifecycle" ;
    sh:targetSubjectsOf kpred:has-status ;
    sh:property [
        sh:path kpred:has-status ;
        sh:in ( "speculative" "planned" "in-progress" "scaffolded" "functional" "production" ) ;
        sh:severity sh:Violation ;
        sh:message "kpred:has-status must be a ktype:FeatureLifecycle notation. Review statuses are a different scheme."
    ] .

kshape:StatementStatus a sh:NodeShape ;
    rdfs:label "Reified statement status must come from the review scheme" ;
    sh:targetSubjectsOf kmeta:status ;
    sh:property [
        sh:path kmeta:status ;
        sh:in ( "pending" "pending-removal" "confirmed" "refined" "rejected" "superseded" ) ;
        sh:maxCount 1 ;
        sh:severity sh:Violation ;
        sh:message "kmeta:status must be one of the ktype:ReviewStatusScheme notations."
    ] .

# ── SET KINDS (F187) ─────────────────────────────────────────────────────────
# What kind of grouping a set is. A set TYPE describes the GROUP the way an
# entity type describes one node, and it is a controlled vocabulary for exactly
# the reason the others here are: the code and the graph must agree on the words.
#
# NOT rdf:type ON THE SET. A collection carries kpred:set-kind pointing at one of
# these concepts. Using rdf:type would make each concept simultaneously an
# individual (a member of this scheme) and a class (the type of a collection) —
# OWL 2 punning, legal but poorly tooled, and a departure from how every other
# vocabulary here is used: the code writes kpred:has-status "functional", never
# rdf:type klife:functional. See kb:ref-figay-skos-owl.

ktype:SetKindScheme a skos:ConceptScheme ;
    rdfs:label "Kinds of set" ;
    skos:definition "What a grouping IS: a page, a story with an order, a roster of like things, or a contrast between two sets of facts." ;
    skos:note "A set may carry no kind at all. An untyped collection is still a collection, and requiring a kind before you can group two things would put a taxonomy decision in front of the simplest possible act." ;
    skos:hasTopConcept kset:page, kset:story, kset:roster, kset:contrast .

kset:page a skos:Concept ;
    skos:inScheme ktype:SetKindScheme ;
    skos:prefLabel "Page" ;
    skos:notation "page" ;
    skos:definition "A set whose members make one document. This is the kind that answers F187.5 — the set defines the page, and its members are the sections." .

kset:story a skos:Concept ;
    skos:inScheme ktype:SetKindScheme ;
    skos:prefLabel "Story" ;
    skos:notation "story" ;
    skos:definition "A set whose ORDER carries meaning: a sequence, a path, a chain of prerequisites. Shuffling it changes what it says, which is what distinguishes it from a roster." ;
    skos:note "A story should be a skos:OrderedCollection. The kind records the intent; the collection type records the mechanism." .

kset:roster a skos:Concept ;
    skos:inScheme ktype:SetKindScheme ;
    skos:prefLabel "Roster" ;
    skos:notation "roster" ;
    skos:definition "A set of like things where order is presentation rather than meaning — the people on a team, the vendors on a shortlist. Sorting it alphabetically loses nothing." .

kset:contrast a skos:Concept ;
    skos:inScheme ktype:SetKindScheme ;
    skos:prefLabel "Contrast" ;
    skos:notation "contrast" ;
    skos:definition "A set that exists to be compared with another — the overlap is the point. Two contrast sets sharing members are what a Venn draws, and the shared membership is derived rather than asserted." .

ktype:SetKindOrder a skos:OrderedCollection ;
    rdfs:label "Set kinds, most structured first" ;
    skos:memberList ( kset:story kset:page kset:contrast kset:roster ) .

# ── The predicates a set uses ────────────────────────────────────────────────
# Declared here so the vocabulary is one file rather than folklore. skos:member
# and skos:prefLabel are the standard's own and need no declaration; these three
# are the local departures, and each says why it exists.

kpred:set-kind a rdf:Property ;
    rdfs:label "set kind" ;
    rdfs:domain skos:Collection ;
    rdfs:range skos:Concept ;
    rdfs:comment "Which kind of set this is, from ktype:SetKindScheme. A PROPERTY rather than rdf:type, to avoid OWL 2 punning — see the scheme's note." .

kpred:member-order a rdf:Property ;
    rdfs:label "member order" ;
    rdfs:comment "The position of ONE member within ONE set, carried on a skolemised membership node. It cannot live on the member itself: an entity may sit third in one set and first in another, and it cannot live in an rdf:List because blank-node labels are not stable across parses (measured 2026-09-08), so a list re-proposes its whole chain on every re-import." .

kpred:set-relates-to a rdf:Property ;
    rdfs:label "set relates to" ;
    rdfs:domain skos:Collection ;
    rdfs:comment "A relation between two SETS, or a set and one entity. LOCAL: SKOS has no Collection-to-Collection relation — its mapping properties relate Concepts, and skos:related is domain and range skos:Concept, so reusing it here would be a range violation." .


## =============================================================================
## RELATION LAYER — claim, provenance, or question.
##
## Matt, 2026-09-09: "the relations of semantic triples needs to be overlapped
## and separate from that of source. They are inherently different relations."
## Then "provenance vs ontology." Then the trichotomy itself: "predicates can be
## decided, provenance, or question?"
##
## WHAT MAKES THESE THREE AND NOT SOME OTHER THREE: each names WHO SETTLES IT.
## A claim is settled by a person. A provenance relation is settled by
## the harness that ran the extraction. A question is not settled, and that is the
## point of it. Three layers, three dispositions, one axis.
##
## An earlier draft of this block used assertion / provenance / STANDING, taking
## the third from nanopublications' publication-info. That was a category error:
## status, supersession and altitude are properties of a STATEMENT and live in
## fields (src/lib/rdf/types.ts), so as a class of PREDICATE the layer was nearly
## empty. Question is not — though it is smaller than first counted: kpred:remaining
## looked like a question and is NOT one. Matt, 2026-09-09: "plan isn\u0027t really a
## question." Its 243 values read "Real-world testing, reconnection handling" and
## "DONE WHEN speakText routes by voiceType" — plans and definitions of done, which
## somebody decided. kpred:open-question reads "Sidecar architecture: Docker
## Compose, standalone FastAPI, or Ollama-style model runner?" — alternatives named,
## nobody has chosen. So the layer is ~140 uses, not 388, and a plan is a claim.
##
## AND IT MAKES THE MISSION OPERATIONAL. "The most useful thing a graph can hold
## is a well-formed absence" is a tenet on the landing page; with question as a
## LAYER it becomes a view you can switch to. Show only this layer and you are
## looking at the shape of what is missing.
##
## THE SHAPE IS NANOPUBLICATIONS-ADJACENT AND THE DEBT IS ACKNOWLEDGED: every
## nanopub is three named graphs sharing IRIs. Ours are three, differently cut,
## because a nanopub cannot express a question. The pattern is an idea and carries
## no licence; their spec is CC BY-SA 3.0, so its prose is not copied and every
## definition below is written fresh.
##
## THIS IS A TRUST BOUNDARY, NOT A TAXONOMY. Matt decided on 2026-09-09 that
## provenance auto-confirms, log included. So a predicate mis-filed as provenance
## would write world-claims into the confirmed graph with NO REVIEW, inverting the
## promise the product is built on. The default is `claim` and it fails toward
## MORE review, never less — the same fail-upward rule ktype:AltitudeScheme uses.
## Forgetting to classify costs a reviewer one card. It cannot cost a silent write.
## =============================================================================

ktype:LayerScheme a skos:ConceptScheme ;
    rdfs:label "Relation layer" ;
    skos:definition "What KIND of relation a predicate expresses, judged by who settles it: a person, the harness, or nobody yet." ;
    skos:note "The discriminating question is what the relation is ABOUT. `Aprimo is-a DAM vendor` is about Aprimo. `Aprimo mentioned-in report.pdf` is about the document. Both are true, both are useful, and drawing them in one picture is why a first-time reader concludes they do not understand triples." ;
    skos:hasTopConcept klayer:claim, klayer:provenance, klayer:question .

klayer:claim a skos:Concept ;
    skos:inScheme ktype:LayerScheme ;
    skos:prefLabel "Claim" ;
    skos:notation "claim" ;
    skos:definition "A claim about the world, which a person settles. This is the layer a reader means when they ask what the graph knows, and the only one that requires human review before it is confirmed." ;
    skos:note "NAMED `claim` RATHER THAN `decided`, DELIBERATELY. `decided` reads as a synonym for status confirmed, and it is not: a PENDING statement sits in this layer and has not been decided at all — that is what the review queue is for. `claim` names what the relation IS, and leaves whether it has been settled to the status field where it belongs." ;
    skos:note "THE FAIL-SAFE DEFAULT. An unclassified predicate lands here, because the alternative auto-confirms it." ;
    skos:closeMatch <https://schema.org/Claim> ;
    skos:note "STANDARDS FOOTING: schema.org carries a Claim type for the same idea — a factual assertion that something else can review — and nanopublications call this the assertion graph. Renaming this layer from `decided` to `claim` moved it TOWARD a standard rather than away from one." ;
    skos:note "LICENCE NOTE, WRITTEN AFTER GETTING IT WRONG HERE: the schema.org vocabulary is CC BY-SA 3.0, and so are the nanopublication guidelines. Using their TERMS — the IRIs, via skos:closeMatch — is free and is the entire point of a shared vocabulary. Pasting their DEFINITION PROSE into a skos:definition or skos:note is redistribution, and ShareAlike would attach to it inside an MIT repository. An earlier draft of this very note quoted schema.org\u0027s wording verbatim. Reference the IRI; write the sentence yourself." ;
    hnav:order 1 .

klayer:provenance a skos:Concept ;
    skos:inScheme ktype:LayerScheme ;
    skos:prefLabel "Provenance" ;
    skos:notation "provenance" ;
    skos:definition "Where a claim came from and how it got here: the source, the passage, the run, the model, the file, the commit. Settled by the harness, because the harness already knows it. It is about a document or a process, never about the world the document describes." ;
    skos:note "THE DISCRIMINATOR, FOUND BY GETTING IT WRONG (2026-09-09). `Settled by the machine` is not enough, because it conflates two different things: a provenance fact the harness KNOWS because it did the work, and a claim about the world the harness can VERIFY. A local model asked to sort 12 predicates filed `imports` and `part-of` as provenance on exactly that confusion — `moduleA imports moduleB` is checkable by a script, so it looked mechanical, but it is a claim ABOUT THE CODE and 981 uses of it would have stopped being reviewed. THE TEST THAT SEPARATES THEM: if every source were deleted, would the statement still mean anything? `A imports B` survives — it is a claim, and Statement.verifiedBy already exists to record that a deterministic check settled it. `This fact came from report.pdf section 3` does not survive; it is only about the source, and that is provenance." ;
    skos:note "AUTO-CONFIRMED, so this list stays small and every entry earns its place. Nothing here is a judgment — which is also the argument for never asking an extractor to decide it. The model emits claims; the harness attaches the provenance. Taking that decision away from the model is what should remove the `an entity is a paragraph` failure, where document structure is mirrored into the concept graph." ;
    skos:note "STANDARDS FOOTING: this is the best-standardized of the three. PROV-O gives it Entity, Activity and Agent, prov:wasDerivedFrom is already emitted by src/lib/rdf/serialize.ts, and W3C Web Annotation gives the passage a shape — `excerpt` plus `grounded` is a hand-rolled TextQuoteSelector that does not yet carry the name." ;
    hnav:order 2 .

klayer:question a skos:Concept ;
    skos:inScheme ktype:LayerScheme ;
    skos:prefLabel "Question" ;
    skos:notation "question" ;
    skos:definition "A relation that is deliberately unsettled: the subject and predicate are known and the object is open, or the whole relation is asked rather than stated. It is answered, not confirmed." ;
    skos:note "ITS LIFECYCLE IS DIFFERENT AND THAT IS WHY IT IS A LAYER. A claim runs pending to confirmed; a question runs asked to answered, and F32 already builds that — needsObject shows the reviewer an entity picker instead of an accept button. Rejecting a question is not the same act as rejecting a claim." ;
    skos:note "STANDARDS FOOTING IS THIN, AND THAT IS WHERE THE INVENTION IS. Three near neighbours and none of them is a layer. Wikidata `somevalue` says a property HAS a value that is unknown, which is exactly needsObject — but it is a value-level marker carrying no asker and no cost. W3C Web Annotation defines oa:questioning for an annotation whose purpose is to ask something about its target — a motivation attached to an annotation, not a relation in a graph. SPARQL is a question that cannot be stored, prioritised, or handed to a person. Two of these three layers are standard; this one is ours." ;
    skos:note "INDEPENDENT CONVERGENCE, AND A WARNING WITH IT. Wikidata represented somevalue with BLANK NODES, found it broken — SPARQL does not honour existential semantics, so isBlank() filtering gives wrong answers — and is migrating to SKOLEM IRIs. F187.2 reached the same conclusion for set membership on its own reasoning, that n3 allocates bnode labels from a process-global counter so a list re-proposes its whole chain on re-import. The largest public knowledge graph hit the same wall on the same construct and made the same correction. The warning is the other half: an open object must be skolemised here too, or this layer inherits the exact bug Wikidata is spending years undoing." ;
    skos:note "A question carries what it BLOCKS. That is the difference between a to-do and a priority, and it is why this layer summarizes best over a SET rather than over a lone triple: a set declares an intent, and an absence is only well-formed relative to something you are trying to do." ;
    hnav:order 3 .

kpred:assumption rdfs:label "extraction assumption" ;
    kpred:layer         klayer:provenance ;
    skos:definition     "Something the extraction had to DECIDE in order to produce a statement, which the source did not say outright. Resolving a pronoun, reading `the vendor` as a named company, dating an undated note from the document around it — each is a judgment the machine made and a reviewer would otherwise have to reconstruct." ;
    skos:note           "Matt, 2026-09-09: MCP responses should carry `the provenance about the extraction process, assumptions, etc.` Nothing recorded assumptions before this. An extraction that silently resolves `they` to a specific person produces a confident triple whose weakest link is invisible — and F197 substantiation cannot weigh a claim whose reasoning was never written down." ;
    skos:note           "IT IS PROVENANCE, NOT A CLAIM, and the survival test says why: an assumption is about how a statement CAME TO BE, and means nothing once separated from the extraction that made it. It therefore auto-confirms with the rest of the provenance layer — recording what the machine assumed is bookkeeping; the assumption being CORRECT is a property of the claim above it, which a person still settles." .

kpred:layer rdfs:label "relation layer" ;
    skos:definition "Which layer of ktype:LayerScheme a PREDICATE belongs to. Declared on the predicate rather than the statement because that makes the boundary a fact a script can enforce instead of a convention that drifts — Matt, 2026-09-09: \"I think its a predicate difference personally.\"" ;
    skos:note "A per-statement override may follow the precedent of kpred:altitude, which fixes one fact where the predicate is usually right. It does not exist yet and should not be added until a real case needs it." .

# =============================================================================
## PRIORITY — 100 uses in the corpus and, until now, no declared vocabulary.
##
## Found 2026-09-10 while adding graph-lint's value-hub check. `kpred:priority`
## carries "high" (86), "medium" (12) and "low" (2) across static/*.ttl, and
## nothing checked any of them: a typo would have been accepted in silence, and
## the value-hub rule could not recognise "high" as a standardized value because
## no scheme said it was one. Declaring it here is what makes both checks work,
## and it is the same argument kb:feature-lifecycle-vocab made in 2026-07-12 —
## the vocabulary belongs in the graph so adding a value is a graph edit.
# =============================================================================

ktype:PriorityScheme a skos:ConceptScheme ;
    rdfs:label "Priority" ;
    skos:definition "How much something matters relative to the other things competing for the same attention." ;
    skos:note "A PRIORITY IS AN ATTRIBUTE VALUE AND NEVER AN ENTITY. Matt, 2026-09-10, on finding a node called 'high' in his graph: it 'misinterprets a key concept of the graph, with instead a standardized attribute value'. Promoted to a node it inherits the degree of every statement that uses it and reads as one of the most important concepts present, when it is a unit. Where the grouping is genuinely wanted — everything currently high priority — model it as a skos:Collection, which declares what it is." ;
    skos:note "Most facts carry no priority at all, and that is the normal case rather than an omission. An unprioritised fact is not low priority; it is simply one nobody has ranked." ;
    skos:hasTopConcept kprio:high, kprio:medium, kprio:low .

kprio:high a skos:Concept ;
    skos:inScheme ktype:PriorityScheme ;
    skos:prefLabel "High" ;
    skos:notation "high" ;
    hnav:order 1 ;
    skos:definition "Acts as a blocker or a deadline: something else waits on it, or the cost of leaving it rises with time." .

kprio:medium a skos:Concept ;
    skos:inScheme ktype:PriorityScheme ;
    skos:prefLabel "Medium" ;
    skos:notation "medium" ;
    hnav:order 2 ;
    skos:definition "Worth doing and nothing waits on it." .

kprio:low a skos:Concept ;
    skos:inScheme ktype:PriorityScheme ;
    skos:prefLabel "Low" ;
    skos:notation "low" ;
    hnav:order 3 ;
    skos:definition "Recorded so it is not lost, and deferring it costs nothing today." .
