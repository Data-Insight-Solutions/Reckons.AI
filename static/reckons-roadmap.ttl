# -- Enterprise: People · Policy · Procedure (F21) ------------------------------

kb:enterprise-3ps rdf:type ktype:Feature ;
               kpred:show-on-landing "true" ;
               kpred:landing-label   "People · Policy · Procedure" ;
               kpred:landing-note    "Structure graphs around the 3 Ps with RBAC, file-based TTL delivery, bring-your-own auth" ;
               rdfs:label   "Enterprise: People · Policy · Procedure" ;
               kpred:has-status   "planned" ;
               kpred:feature-id   "F21" ;
               kpred:description  "Structure organizational knowledge around the 3 Ps framework: People (who knows what — RBAC, teams, ownership, delegation, audit trails, trust scores), Policy (what governs it — legal constraints, cultural norms, compliance rules, data classification, retention policies), Procedure (how it gets done — SOPs, decision trees, process graphs, checklists, runbooks). Each dimension maps naturally to RDF triples. Key design decisions: file-based TTL delivery (portable W3C format, diffable via git, no proprietary lock-in), Bring Your Own Auth (organizations plug in existing SSO/LDAP/OIDC/SAML — no built-in identity provider), graph-native RBAC (permissions are triples, queryable and time-bounded), and self-hosted operation (n8n cloud sync on the organization's infrastructure, air-gapped first-class). Personal Reckons.AI remains unchanged; enterprise is an opt-in layer." ;
               kpred:has-dimension kb:ent-people ;
               kpred:has-dimension kb:ent-policy ;
               kpred:has-dimension kb:ent-procedure ;
               kpred:has-phase    kb:ent-phase-1 ;
               kpred:has-phase    kb:ent-phase-2 ;
               kpred:has-phase    kb:ent-phase-3 ;
               kpred:has-phase    kb:ent-phase-4 .

kb:ent-people  rdf:type     ktype:Concept ;
               rdfs:label   "People (Enterprise)" ;
               kpred:description  "Role-based access controls. Team graphs with ownership, delegation, and audit trails. Graph-native RBAC — permissions are triples, queryable and time-bounded." .

kb:ent-policy  rdf:type     ktype:Concept ;
               rdfs:label   "Policy (Enterprise)" ;
               kpred:description  "Legal, cultural, and compliance constraints as first-class graph entities. Temporal bounds, provenance, governed-by relationships. Policies travel with the knowledge they govern." .

kb:ent-procedure rdf:type   ktype:Concept ;
               rdfs:label   "Procedure (Enterprise)" ;
               kpred:description  "Depth of specifics — SOPs, decision trees, process graphs. Step ordering, decision points, SLAs. From high-level intent to step-by-step execution." .

kb:ent-byoa    rdf:type     ktype:Concept ;
               rdfs:label   "Bring Your Own Auth" ;
               kpred:description  "No built-in identity provider. Organizations plug in SSO, LDAP, OIDC, or SAML. Auth gateway validates tokens and maps to RBAC roles from the graph." ;
               kpred:related      kb:enterprise-3ps .

kb:ent-ttl-delivery rdf:type ktype:Concept ;
               rdfs:label   "File-Based TTL Delivery" ;
               kpred:description  "Enterprise graphs distributed as .ttl files. Portable W3C standard. Diffable via git. Offline-first. No proprietary format, no database dependency." ;
               kpred:related      kb:enterprise-3ps .

kb:ent-phase-1 rdf:type   ktype:Concept ;
               rdfs:label   "Enterprise Phase 1: Graph-Native RBAC" ;
               kpred:description  "Define role/permission vocabulary as RDF predicates. Four roles (Viewer, Contributor, Reviewer, Admin) with scoping at graph, graph, and entity levels. RBAC evaluation engine (client-side, reads permission triples). Admin UI for role assignment. Audit trail logging — every mutation records actor, action, target, and timestamp as triples." ;
               kpred:has-status   "planned" .

kb:ent-phase-2 rdf:type   ktype:Concept ;
               rdfs:label   "Enterprise Phase 2: BYOA Auth Gateway" ;
               kpred:description  "Bring Your Own Auth — thin middleware that validates tokens from the organization's identity provider and maps identities to RBAC roles defined in the graph. Supported protocols: OIDC (Okta, Auth0, Entra ID), LDAP (on-premise Active Directory), SAML (legacy enterprise SSO), API Key (machine-to-machine for MCP, n8n, CI/CD). No stored credentials, no sessions — stateless token validation only." ;
               kpred:has-status   "planned" ;
               kpred:depends-on   kb:ent-phase-1 .

kb:ent-phase-3 rdf:type   ktype:Concept ;
               rdfs:label   "Enterprise Phase 3: Policy & Procedure Modeling" ;
               kpred:description  "Policy entity type with temporal bounds (effective-date, superseded-by), provenance, and governed-by relationships. Procedure entity type with step ordering, decision points, SLAs, on-failure branches. Policies travel with the knowledge they govern. Procedures become navigable process graphs in the 3D view. Reckoning becomes policy-aware. Diff/review shows governed-by relationships." ;
               kpred:has-status   "planned" ;
               kpred:depends-on   kb:ent-phase-1 .

kb:ent-phase-4 rdf:type   ktype:Concept ;
               rdfs:label   "Enterprise Phase 4: Team Workflows" ;
               kpred:description  "Shared graph registry backed by n8n data tables. Merge request workflow: propose, review, accept — with multi-reviewer support. Conflict resolution across concurrent edits. Activity feed and notification via n8n webhooks (Slack, email, ntfy). Team members export TTL, submit via n8n sync hub or git PR, reviewer imports and curates." ;
               kpred:has-status   "planned" ;
               kpred:depends-on   kb:ent-phase-2 ;
               kpred:depends-on   kb:ent-phase-3 .

