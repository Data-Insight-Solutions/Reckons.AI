# -- Context Compression --------------------------------------------------------

kb:context-compression rdf:type ktype:Feature ;
               kpred:tested-by    "mcp-server/src/__tests__/compress.test.ts" ;
               kpred:measured     "MEASURED 2026-07-12 (compress.test.ts): the compression FORMAT saves ~18% vs grouped Turtle (what a real .ttl looks like) and ~29% vs flat one-triple-per-line Turtle. The docs previously claimed ~60-70%, which was WRONG for the format — that figure conflated the encoding with SUBGRAPH SELECTION, which is where the large saving actually comes from (returning a relevant slice instead of the whole ~116k-token graph). Selection is the headline; the format is a modest, real win on top of it. The test asserts a >=15% floor, so if the encoding ever regresses below what we claim, CI says so." ;
               kpred:honest-note  "Writing the first test for this feature falsified its own headline claim (kb:honest-status). It also found a bug: stats.facts counted the facts of an entity that the token budget had DROPPED, because the counter was incremented while building the block and the budget check broke afterwards." ;
               kpred:show-on-landing "true" ;
               kpred:landing-label   "Context compression" ;
               kpred:landing-note    "Condense your knowledge graph for LLM context — semantic meaning preserved, tokens reduced" ;
               rdfs:label   "Context Compression" ;
