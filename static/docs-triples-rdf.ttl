## =============================================================================
## The Semantic Triple Architecture
## =============================================================================

## Sets sit BESIDE the triple as the second unit, not under it. Added 2026-09-11
## when grouping became part of extraction rather than only of the docs site.
## Written for a first-time reader: no jargon is used here that is not explained
## in the sentence that uses it (kb:journey-docs — unexplained jargon is a defect,
## not a style choice).

arch:TripleArchitecture
    rdf:type            ktype:Concept ;
    kpred:render-as     "accordion" ;
    rdf:type            skos:Concept ;
    rdfs:label          "The Semantic Triple" ;
    hnav:order          20 ;
    skos:definition     "The fundamental unit of knowledge in RDF: a three-part statement -- subject, predicate, object. Any fact expressible in human language can be expressed as a triple. Triples connect to form a graph, and graphs reveal relationships that documents hide." ;
    skos:related        guide:WhatIsReckonsAI .

arch:SubjectPredicateObject
    rdf:type            ktype:Concept ;
    rdf:type            skos:Concept ;
    rdfs:label          "Subject - Predicate - Object" ;
    skos:definition     "Subject: the entity being described (always an IRI). Predicate: the relationship or property (always an IRI). Object: the value or target (an IRI or a literal string/number/date). Example: 'Alice worksAt AcmeCorp'. Example: 'Policy covers water-damage'." ;
    skos:broader        arch:TripleArchitecture ;
    skos:example        "In 'Earth orbits Sun', Earth=subject, orbits=predicate, Sun=object." .

arch:Literal
    rdf:type            ktype:Concept ;
    rdf:type            skos:Concept ;
    rdfs:label          "Literal Values" ;
    skos:definition     "A data value in RDF: a string, number, date, or boolean. Literals can have a language tag (@en) or a datatype IRI (^^xsd:integer). Example: '42'^^xsd:integer is a typed literal." ;
    skos:broader        arch:TripleArchitecture .

arch:IRI
    rdf:type            ktype:Concept ;
    rdf:type            skos:Concept ;
    rdfs:label          "IRI (Identifier)" ;
    skos:definition     "A globally unique identifier for a resource. IRIs are the names of things in RDF -- like URLs but for any concept, not just web pages. Example: urn:reckons:guide/WhatIsReckonsAI" ;
    skos:broader        arch:TripleArchitecture .

arch:KnowledgeGraph
    rdf:type            ktype:Concept ;
    rdf:type            skos:Concept ;
    rdfs:label          "Knowledge Graph" ;
    skos:definition     "A graph-structured database where entities are nodes and relationships are edges. Multiple triples form a graph. The same subject can appear in many triples, creating a web of connected knowledge." ;
    skos:broader        arch:TripleArchitecture ;
    skos:note           "Reckons.AI renders your knowledge graph as an interactive 3D force-directed graph." ;
    kpred:scene         """
  camera.position.set(0, 0, 6);
  scene.add(new THREE.AmbientLight(0xffffff, 0.55));
  const key = new THREE.DirectionalLight(0xffffff, 1.1);
  key.position.set(4, 5, 6); scene.add(key);
  const nodes = [];
  const N = 9;
  for (let i = 0; i < N; i++) {
    const a = (i / N) * Math.PI * 2;
    const m = new THREE.Mesh(
      new THREE.IcosahedronGeometry(0.34, 2),
      new THREE.MeshStandardMaterial({ color: 0xff7a1a, roughness: 0.35, metalness: 0.1 })
    );
    m.position.set(Math.cos(a) * 2.6, Math.sin(a) * 1.5, Math.sin(a * 2) * 0.6);
    scene.add(m); nodes.push(m);
  }
  const edge = new THREE.LineBasicMaterial({ color: 0x8899aa, transparent: true, opacity: 0.55 });
  for (let i = 0; i < N; i++) for (const j of [i + 1, i + 3]) {
    const b = nodes[j % N];
    const g = new THREE.BufferGeometry().setFromPoints([nodes[i].position, b.position]);
    scene.add(new THREE.Line(g, edge));
  }
""" ;
    kpred:scene-width   1200 ;
    kpred:scene-height  480 ;
    kpred:scene-alt     "Nine spheres arranged in a ring, connected by thin lines to the neighbours one and three places along — entities joined by the relations asserted between them." ;
    kpred:scene-caption "A graph is nodes and the named edges between them. Rendered once at build time, so this page still ships no JavaScript." ;
    kpred:scene-live    "graph-ring" .

arch:Provenance
    rdf:type            ktype:Concept ;
    rdf:type            skos:Concept ;
    rdfs:label          "Provenance" ;
    skos:definition     "Every triple in Reckons.AI carries its source. You always know where a fact came from, how trusted that source is, and when it was added. Metadata about metadata -- this is what makes a graph trustworthy." ;
    skos:broader        arch:TripleArchitecture ;
    skos:related        feat:TrustSystem .

arch:Reification
    rdf:type            ktype:Concept ;
    rdf:type            skos:Concept ;
    rdfs:label          "Reification" ;
    skos:definition     "Making a statement about a statement. In RDF, reification assigns an IRI to a triple so it can be annotated with provenance, confidence, or temporal bounds. Reckons.AI uses reification in its TTL export format." ;
    skos:broader        arch:TripleArchitecture .

arch:PlainTextPortability
    rdf:type            ktype:Concept ;
    rdf:type            skos:Concept ;
    rdfs:label          "Plain Text Portability" ;
    skos:definition     "Your knowledge graph exports as a .ttl file -- plain text, human-readable, no proprietary format. You can open it in any text editor, diff it with git, email it, or print it. When apps shut down and formats die, your .ttl file will still work. It is the most durable way to store knowledge." ;
    skos:broader        arch:TripleArchitecture ;
    skos:note           "Any RDF tool (SPARQL endpoints, Protege, PoolParty, Neo4j, Python's rdflib) can read your .ttl file directly." .

arch:ReviewWorkflow
    rdf:type            ktype:Document ;
    rdf:type            skos:Concept ;
    rdfs:label          "The Review Workflow" ;
    skos:definition     "1. Ingest -- paste text, upload documents, import calendars. 2. Review -- the AI proposes facts and, where your text already grouped things, the groups they belong to; you confirm or reject each one. 3. Explore -- navigate your 3D knowledge graph. 4. Ask Shelly -- get answers grounded in your confirmed facts. 5. Share -- export your .ttl." ;
    skos:related        arch:SetInExtraction ;
    skos:broader        arch:TripleArchitecture ;
    skos:related        feat:Ingest ;
    skos:related        feat:ReviewSystem .


## =============================================================================
## Sets — the second unit of knowledge
## =============================================================================

arch:SetArchitecture
    rdf:type            ktype:Concept ;
    kpred:render-as     "accordion" ;
    rdf:type            skos:Concept ;
    rdfs:label          "The Set" ;
    hnav:order          25 ;
    skos:definition     "A set is a named group of things, and it is made of ordinary statements just like everything else here. Where a triple says something about ONE thing, a set says something about SEVERAL at once -- that these three vendors are the shortlist, that these five steps are the recipe. It has a name, a description and facts of its own, so you can say things about the group without saying them about each member." ;
    skos:note           "You may see the word Collection in exported files. It is the same thing under its standard name -- Reckons.AI writes sets as skos:Collection so other tools can read them." ;
    skos:related        arch:TripleArchitecture .

arch:SetVsTriple
    rdf:type            ktype:Concept ;
    rdf:type            skos:Concept ;
    rdfs:label          "What a set says that triples cannot" ;
    skos:definition     "Triples alone cannot tell the difference between a fact about a GROUP and the same fact about each of its members. 'The team weighs 800 kilos' and 'each person on the team weighs 800 kilos' come out identical if the only thing you can describe is one member at a time. Giving the group its own name and its own facts separates them. That is the one thing a set genuinely adds, and it is why sets are part of the substrate rather than a way of laying out a page." ;
    skos:broader        arch:SetArchitecture ;
    skos:example        "A set called 'DAM shortlist' can carry 'decided on 2026-08-14' and 'three of eleven considered' -- facts about the shortlist, true of no single vendor in it." .

arch:SetOverlap
    rdf:type            ktype:Concept ;
    rdf:type            skos:Concept ;
    rdfs:label          "Membership overlaps -- it does not file things away" ;
    skos:definition     "A thing can belong to as many sets as it really belongs to. A vendor can be on the shortlist AND already deployed; a person can be in the project team AND the football team. This is the difference between a set and a folder: a folder makes you choose one home for a thing, and choosing wrongly hides it. Where two sets share members, that shared part is itself worth looking at -- Reckons.AI works it out rather than asking you to maintain a list of related things by hand." ;
    skos:broader        arch:SetArchitecture ;
    skos:note           "This turned out to be the hard part for automatic grouping. In a benchmark of four local AI models across five runs each, not one ever put a single thing into two sets -- every model filed each thing in exactly one place. It is the main reason grouping here does not rely on a model." .

arch:SetOrder
    rdf:type            ktype:Concept ;
    rdf:type            skos:Concept ;
    rdfs:label          "Order belongs to the membership, not to the member" ;
    skos:definition     "Some sets are sequences -- the steps of a recipe, the stages of a process. When order matters, the position is recorded against the PAIR of set-and-member rather than against the member, because the same thing can be third in one sequence and first in another. A step is not inherently step four; it is step four of this particular process." ;
    skos:broader        arch:SetArchitecture ;
    skos:note           "Most sets are not sequences and pay nothing for this. Ordering a set costs about four times as much storage per member as leaving it unordered, so it is worth applying only where the sequence actually carries meaning." .

arch:SetMembershipWord
    rdf:type            ktype:Concept ;
    rdf:type            skos:Concept ;
    rdfs:label          "A set can keep your own word for membership" ;
    skos:definition     "Most groupings already exist in your notes under a word you chose -- a project 'includes' these tasks, a menu 'offers' these dishes. Reckons.AI can mark that thing as a set without rewriting any of it, by recording which of your words carries the membership. Your vocabulary is kept; nothing is duplicated; and the group becomes something you can name, describe and view as a whole." ;
    skos:broader        arch:SetArchitecture ;
    skos:example        "'Project Ash includes design, build, handover' stays exactly as written. One extra fact says Project Ash is a set, and another says that 'includes' is what its membership is carried by." .

arch:SetInExtraction
    rdf:type            ktype:Concept ;
    rdf:type            skos:Concept ;
    rdfs:label          "How groups are found when you add something" ;
    skos:definition     "When you add a note or a document, Reckons.AI looks for groups in what it just read, as a separate step after it has worked out the individual facts. It only proposes a group where your text already put several things under one heading -- it does not guess that a list is a group, and it never adds one on its own. Every proposal waits for you in Review, and it says why it grouped what it did." ;
    skos:broader        arch:SetArchitecture ;
    skos:note           "It says what it REFUSED as well as what it found. A grouping step that only reports its successes looks cleverer than it is -- in the benchmark that informed this, the two models with a perfect record for not over-grouping achieved it by never grouping anything at all." .


## =============================================================================
## Turtle Syntax and RDF Standards
## =============================================================================

topic:Turtle
    rdf:type            ktype:Document ;
    rdf:type            skos:Concept ;
    rdfs:label          "Turtle (.ttl) Syntax" ;
    skos:definition     "A compact, human-readable syntax for writing RDF triples. File extension: .ttl. Uses prefix declarations, semicolons to share subjects, commas to share predicates, and periods to end statement groups. This file is itself written in Turtle." ;
    skos:broader        arch:TripleArchitecture .

topic:TurtlePrefix
    rdf:type            ktype:Concept ;
    rdf:type            skos:Concept ;
    rdfs:label          "@prefix Declaration" ;
    skos:definition     "Declares a short alias for a namespace IRI. Example: @prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> . Prefixes make Turtle readable -- without them every IRI needs full angle-bracket notation." ;
    skos:broader        topic:Turtle .

topic:TurtleSemicolon
    rdf:type            ktype:Concept ;
    rdf:type            skos:Concept ;
    rdfs:label          "Semicolon (;) -- Same Subject" ;
    skos:definition     "In Turtle, a semicolon separates predicate-object pairs that share the same subject. Example: ex:Earth rdf:type ex:Planet ; ex:orbits ex:Sun ." ;
    skos:broader        topic:Turtle .

topic:TurtleComma
    rdf:type            ktype:Concept ;
    rdf:type            skos:Concept ;
    rdfs:label          "Comma (,) -- Same Subject and Predicate" ;
    skos:definition     "In Turtle, a comma separates objects that share the same subject and predicate. Example: ex:Earth ex:hasOcean ex:Pacific , ex:Atlantic , ex:Indian ." ;
    skos:broader        topic:Turtle .

topic:TurtlePeriod
    rdf:type            ktype:Concept ;
    rdf:type            skos:Concept ;
    rdfs:label          "Period (.) -- End of Statement Group" ;
    skos:definition     "A period terminates a group of triples about the same subject." ;
    skos:broader        topic:Turtle .

topic:RDF
    rdf:type            ktype:Concept ;
    rdf:type            skos:Concept ;
    rdfs:label          "RDF (Resource Description Framework)" ;
    skos:definition     "A W3C standard for representing knowledge as a graph of linked statements. The foundation of the Semantic Web. RDF itself is abstract -- Turtle, JSON-LD, and RDF/XML are concrete serialization formats." ;
    skos:broader        arch:TripleArchitecture .

topic:RDFS
    rdf:type            ktype:Concept ;
    rdf:type            skos:Concept ;
    rdfs:label          "RDF Schema (RDFS)" ;
    skos:definition     "A vocabulary for describing classes and properties: rdfs:Class, rdfs:subClassOf, rdfs:domain, rdfs:range, rdfs:label, rdfs:comment. Reckons.AI uses rdfs:label for human-readable entity names." ;
    skos:broader        topic:RDF .

topic:SKOS
    rdf:type            ktype:Concept ;
    rdf:type            skos:Concept ;
    rdfs:label          "SKOS (Simple Knowledge Organization System)" ;
    skos:definition     "A vocabulary for taxonomies and concept hierarchies using skos:broader, skos:narrower, skos:related. This documentation file uses SKOS to organize concepts." ;
    skos:broader        topic:RDF .

topic:SPARQL
    rdf:type            ktype:Concept ;
    rdf:type            skos:Concept ;
    rdfs:label          "SPARQL" ;
    skos:definition     "The query language for RDF graphs. Like SQL for relational databases, but for triple stores. Example: SELECT ?name WHERE { ?person foaf:name ?name }" ;
    skos:broader        topic:RDF .

topic:JSONLD
    rdf:type            ktype:Concept ;
    rdf:type            skos:Concept ;
    rdfs:label          "JSON-LD" ;
    skos:definition     "JSON-based serialization for RDF. Embeds linked data in standard JSON using a @context object. Popular for web APIs." ;
    skos:broader        topic:RDF ;
    skos:related        topic:Turtle .

topic:LinkedData
    rdf:type            ktype:Concept ;
    rdf:type            skos:Concept ;
    rdfs:label          "Linked Data" ;
    skos:definition     "Tim Berners-Lee's principles for publishing data on the web: use IRIs, use HTTP, provide useful RDF, and link to other datasets." ;
    skos:broader        topic:RDF .

topic:PROVO
    rdf:type            ktype:Concept ;
    rdf:type            skos:Concept ;
    rdfs:label          "PROV-O (Provenance Ontology)" ;
    skos:definition     "A W3C vocabulary for expressing provenance: who created something, when, and from what sources. Reckons.AI uses prov:wasDerivedFrom to link statements to their source." ;
    skos:broader        topic:RDF ;
    skos:related        arch:Provenance .


