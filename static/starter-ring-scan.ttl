## The ring — an unlisted public example space (F292.3, kb:ring-scan-space).
## Opened by the link /about?example=ring-scan; it is NOT in the examples list. Unlisted is not private:
## this file and static/scans/ring/ring.spz are public. The ring is RECONSTRUCTED from photographs (COLMAP
## camera poses, Brush training); no model generated it. Every number below comes from the pipeline's
## receipts. The frames, the source video and the local paths stay private and are not in this repository.

@prefix rdf:   <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .
@prefix ktype: <urn:kbase:type/> .
@prefix kb:    <urn:kbase:concept/> .
@prefix p:     <urn:kbase:predicate/> .
@prefix kmeta: <urn:kbase:meta/> .
@prefix hnav:  <urn:reckons:nav/> .
@prefix story: <urn:reckons:story/> .
@prefix ring:  <urn:reckons:ring/> .

ring:the-ring rdf:type ktype:Concept ;
    rdfs:label "The ring" ;
    rdfs:comment "A ring with the letters UNLV on its front face, filmed on a checkered scan board and rebuilt on one computer as a 3D Gaussian splat (a cloud of small coloured blobs you can orbit). It is RECONSTRUCTED from photographs of the real object, not generated by a model, so the shape is measured where the camera saw it. Its underside was never filmed, so that part is not in the splat. Who owns it and what it is for are not recorded here." ;
    p:has ring:capture, ring:frame-review, ring:pose-recovery, ring:training, ring:trim, ring:ring-splat, ring:scan-your-own, ring:made-by .

ring:capture rdf:type ktype:Concept ;
    rdfs:label "1. Capture: one video on a scan board" ;
    rdfs:comment "One phone video, 53 seconds long, 4K at 120 frames per second, of the ring sitting on a checkered scan board, filmed from many angles. The board gives the software many easy points to match between frames. The video itself stays private." ;
    hnav:order "1"^^xsd:integer ;
    hnav:layer "1"^^xsd:integer ;
    hnav:next  ring:frame-review .

ring:frame-review rdf:type ktype:Concept ;
    rdfs:label "2. Keep the sharp frames" ;
    rdfs:comment "373 candidate frames were pulled from the video. A frame-by-frame review kept 189: sharp frames from differing angles. The rest were rejected for blur (54) or for being near-duplicates of a neighbour (130). The review notes that the underside of the ring, which rests on the board, is not covered. The frames stay private." ;
    hnav:order "2"^^xsd:integer ;
    hnav:layer "1"^^xsd:integer ;
    hnav:prev  ring:capture ;
    hnav:next  ring:pose-recovery .

ring:pose-recovery rdf:type ktype:Concept ;
    rdfs:label "3. Recover where the camera was" ;
    rdfs:comment "COLMAP works out, for every kept frame, where the camera stood and where it pointed, by matching points between frames (sequential matching, each frame against its 10 neighbours, one shared camera model). All 189 of 189 frames were placed. This stage took 308.2 seconds." ;
    p:uses ring:colmap ;
    hnav:order "3"^^xsd:integer ;
    hnav:layer "1"^^xsd:integer ;
    hnav:prev  ring:frame-review ;
    hnav:next  ring:training .

ring:training rdf:type ktype:Concept ;
    rdfs:label "4. Train the splat" ;
    rdfs:comment "Brush fits a cloud of Gaussians (soft coloured blobs) so that, seen from each recovered camera, it looks like the matching frame. 30,000 training steps took 795.5 seconds, with seed 42. The result covers the ring and the board around it: 341,115 Gaussians before trimming." ;
    p:uses ring:brush ;
    hnav:order "4"^^xsd:integer ;
    hnav:layer "1"^^xsd:integer ;
    hnav:prev  ring:pose-recovery ;
    hnav:next  ring:trim .

ring:trim rdf:type ktype:Concept ;
    rdfs:label "5. Trim the board away" ;
    rdfs:comment "The board was removed with a surface fitted to it, keeping only what stands above it near the ring, then the largest connected cluster. 341,115 Gaussians became 11,214. Known losses: about 5 percent of the ring's height is cut at the base (0.03 of 0.6 units), and some needle-like Gaussians remain at the edges." ;
    hnav:order "5"^^xsd:integer ;
    hnav:layer "1"^^xsd:integer ;
    hnav:prev  ring:training .

ring:colmap rdf:type ktype:Concept ;
    rdfs:label "COLMAP (camera pose recovery)" ;
    rdfs:comment "Open-source structure-from-motion software. It finds the camera positions; it does not make the splat." .

ring:brush rdf:type ktype:Concept ;
    rdfs:label "Brush 0.3.0 (splat training)" ;
    rdfs:comment "Open-source Gaussian splat trainer, version brush-cli 0.3.0 as recorded in the receipt." .

ring:ring-splat rdf:type ktype:GaussianSplat ;
    rdfs:label "Splat: the ring (reconstructed)" ;
    p:splat "/scans/ring/ring.spz" ;
    kmeta:splat-origin "reconstructed" ;
    p:made-from ring:capture ;
    p:generated-with "COLMAP poses, Brush 0.3.0 training, local surface-fit trim" ;
    p:generated-gaussians "11214" ;
    p:generated-seed "42" ;
    p:generated-at "2026-11-12" ;
    rdfs:comment "RECONSTRUCTED from 189 photographs, not generated. 11,214 Gaussians, stored as .spz (about 289 KB, lossy), upright with the UNLV face toward the viewer. Limits: the underside was never filmed; about 5 percent of the height is lost at the base; needle-like edge Gaussians remain." .

ring:scan-your-own rdf:type ktype:Concept ;
    rdfs:label "Scan your own object" ;
    rdfs:comment "This is not only a story. On a computer with the tools, npm run scan:room turns a video or a folder of frames into a splat (COLMAP poses, Brush training, a receipt that records the numbers), and --check verifies a finished scan. Then, in the Graphs tab under space background, press Import a scan and pick the .ply or .spz file. The Your room example walks through the same steps for a room. A browser cannot run the training itself." ;
    p:uses ring:ring-splat .

ring:made-by rdf:type ktype:Concept ;
    rdfs:label "The same ring on the Data Insight Solutions website" ;
    rdfs:comment "The ring is also shown on the Data Insight Solutions About page, in a viewer that website hosts itself." ;
    <urn:reckons:leap> "https://data-insight.solutions/about/" ;
    <urn:reckons:leap/label> "Open the About page" .

story:ring-to-asset rdf:type story:Story ;
    rdfs:label "How this ring became a 3D asset" ;
    story:description "A ring filmed on a scan board becomes a 3D splat you can orbit, in five steps. It is rebuilt from photographs, not generated by a model." ;
    story:autoplay "false" .

story:ring-step-capture rdf:type story:Step ;
    story:partOf story:ring-to-asset ;
    story:order "1"^^xsd:integer ;
    story:title "Film it on a board" ;
    story:content "One 53 second video, 4K at 120 frames per second, of the ring on a checkered scan board, from many angles." ;
    story:highlight ring:capture .

story:ring-step-frames rdf:type story:Step ;
    story:partOf story:ring-to-asset ;
    story:order "2"^^xsd:integer ;
    story:title "Keep the sharp frames" ;
    story:content "373 candidate frames were reviewed one by one. 189 were kept: sharp, and from differing angles. 54 were blurred and 130 repeated their neighbour." ;
    story:highlight ring:frame-review .

story:ring-step-poses rdf:type story:Step ;
    story:partOf story:ring-to-asset ;
    story:order "3"^^xsd:integer ;
    story:title "Recover where the camera was" ;
    story:content "COLMAP matched points between frames and placed the camera for all 189 of 189 frames in 308.2 seconds." ;
    story:highlight ring:pose-recovery, ring:colmap .

story:ring-step-train rdf:type story:Step ;
    story:partOf story:ring-to-asset ;
    story:order "4"^^xsd:integer ;
    story:title "Train the splat" ;
    story:content "Brush fitted a cloud of coloured blobs to the frames: 30,000 steps in 795.5 seconds, 341,115 Gaussians including the board." ;
    story:highlight ring:training, ring:brush .

story:ring-step-trim rdf:type story:Step ;
    story:partOf story:ring-to-asset ;
    story:order "5"^^xsd:integer ;
    story:title "Trim the board away" ;
    story:content "Removing the board left 11,214 Gaussians: the ring. About 5 percent of its height is lost at the base. Open the splat node to orbit it, or see Scan your own object to do the same with yours." ;
    story:highlight ring:trim, ring:ring-splat, ring:scan-your-own .
