## The ring — an unlisted public example space (F292.3, kb:ring-scan-space).
## Opened by the link /about?example=ring-scan; it is NOT in the examples list. Unlisted is not private:
## this file and static/scans/ring/ring.spz are public. The ring is RECONSTRUCTED from photographs (COLMAP
## camera poses, Brush training); no model generated it. Every number below comes from the pipeline's
## receipts. Matt (the owner of the footage) asked on 2026-11-12 for the video, its frames and the whole
## creation process to be included: a 720p trimmed web video (no audio) and a few 480 px frames are public
## here. The full-size video, the other frames and the local paths are not in this repository. Twenty-four sampled
## frames across the whole video were checked for people, screens, documents and addresses (none found).

@prefix rdf:   <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .
@prefix ktype: <urn:kbase:type/> .
@prefix kb:    <urn:kbase:concept/> .
@prefix p:     <urn:kbase:predicate/> .
@prefix kmeta: <urn:kbase:meta/> .
@prefix hnav:  <urn:reckons:nav/> .
@prefix story: <urn:reckons:story/> .
@prefix ring:  <urn:reckons:ring/> .

ring:the-ring rdf:type ktype:Concept ;
    rdfs:label "The ring" ;
    rdfs:comment "A ring with the letters UNLV on its front face, filmed on a checkered scan board and rebuilt on one computer as a 3D Gaussian splat (a cloud of small coloured blobs you can orbit). It is RECONSTRUCTED from photographs of the real object, not generated by a model, so the shape is measured where the camera saw it. Its underside was never filmed, so that part is not in the splat. Who owns it and what it is for are not recorded here. Follow the numbered steps from 1 to 8 to see how a phone video became the splat." ;
    p:has ring:capture, ring:extract-frames, ring:frame-review, ring:pose-recovery, ring:training, ring:trim, ring:orient-compress, ring:show, ring:ring-splat, ring:scan-your-own, ring:made-by, ring:what-is-manual, ring:open-frame-selection .

ring:capture rdf:type ktype:Concept ;
    rdfs:label "1. Film it on the scan board" ;
    rdfs:comment "One phone video, 53 seconds long, 4K at 120 frames per second, of the ring sitting on a checkered scan board, filmed by hand from many angles. The board gives the software many easy points to match between frames. A short clip of the video (16 seconds, from second 30 to second 46, shrunk to 720 pixels wide, 30 frames per second, no sound, about 2.3 MB) is on this node so you can see the raw material; the 4K original is not published. Done by a person with a phone." ;
    p:has ring:source-video ;
    hnav:order "1"^^xsd:integer ;
    hnav:layer "1"^^xsd:integer ;
    hnav:next  ring:extract-frames .

ring:source-video rdf:type ktype:Video ;
    rdfs:label "Video: the ring on the scan board (16 s clip of the 53 s original)" ;
    p:video "/scans/ring/ring-orbit.webm" ;
    p:generated-with "ffmpeg: seconds 30 to 46 of the original, 720 px wide, 30 fps, VP9, audio removed" ;
    rdfs:comment "A trimmed web copy of the real phone video (not generated). The original is 53 seconds of 4K HEVC at 120 frames per second. This clip is the part where the camera moves slowly around the front-quarter of the ring, which is the clearest continuous stretch." .

ring:extract-frames rdf:type ktype:Concept ;
    rdfs:label "2. Pull out candidate frames" ;
    rdfs:comment "The video was cut into still pictures at 24 per second, and the best picture in each short window (the sharpest on a crop around the ring, by variance of the Laplacian, a standard sharpness score) was kept as a candidate: 373 candidates in all, about 7 per second of video. Done by a script." ;
    hnav:order "2"^^xsd:integer ;
    hnav:layer "1"^^xsd:integer ;
    hnav:prev  ring:capture ;
    hnav:next  ring:frame-review .

ring:frame-review rdf:type ktype:Concept ;
    rdfs:label "3. Keep the sharp frames from differing angles" ;
    rdfs:comment "A person looked at every candidate (contact sheets of thumbnails for the angle, then a close crop for crispness) and kept 189 that are sharp and from differing angles. 184 were rejected: 54 for blur and 130 for being near-duplicates of a neighbour. None was rejected for a hand, a shadow or for leaving the frame. The review notes that the underside of the ring, which rests on the board, is not covered, and that the ring is only about 200 pixels wide at the training size, so each diamond is a few pixels. THIS STEP IS MANUAL: the sharpness score only ranks, a human chose. Six kept frames and four rejected ones are on the nodes linked here; the other frames are not published." ;
    p:has ring:frames-contact-sheet, ring:frame-kept-1, ring:frame-kept-2, ring:frame-kept-3, ring:frame-kept-4, ring:frame-kept-5, ring:frame-kept-6, ring:frame-rejected-blur-1, ring:frame-rejected-blur-2, ring:frame-rejected-dup-1, ring:frame-rejected-dup-2 ;
    hnav:order "3"^^xsd:integer ;
    hnav:layer "1"^^xsd:integer ;
    hnav:prev  ring:extract-frames ;
    hnav:next  ring:pose-recovery .

ring:frames-contact-sheet rdf:type ktype:Image ;
    rdfs:label "Contact sheet: 24 of the 189 kept frames, spread across the video" ;
    p:photo "/scans/ring/frames/contact-sheet.webp" ;
    rdfs:comment "Every eighth or so kept frame, in time order, to show how the angle changes around the ring." .

ring:frame-kept-1 rdf:type ktype:Image ;
    rdfs:label "Kept frame at 1.04 s: low side view, the opening dwell" ;
    p:photo "/scans/ring/frames/kept-01.webp" ;
    rdfs:comment "Candidate 8, sharpness score 803. Kept because it adds a low side view of the band." .

ring:frame-kept-2 rdf:type ktype:Image ;
    rdfs:label "Kept frame at 8.42 s: rising onto the front face" ;
    p:photo "/scans/ring/frames/kept-02.webp" ;
    rdfs:comment "Candidate 60, score 1,309. The crispest stretch of the video starts here." .

ring:frame-kept-3 rdf:type ktype:Image ;
    rdfs:label "Kept frame at 12.88 s: high front view" ;
    p:photo "/scans/ring/frames/kept-03.webp" ;
    rdfs:comment "Candidate 91, score 2,221. One of the few top-down angles." .

ring:frame-kept-4 rdf:type ktype:Image ;
    rdfs:label "Kept frame at 20.04 s: down the side" ;
    p:photo "/scans/ring/frames/kept-04.webp" ;
    rdfs:comment "Candidate 141, score 1,648." .

ring:frame-kept-5 rdf:type ktype:Image ;
    rdfs:label "Kept frame at 38.08 s: front-quarter of the stone face" ;
    p:photo "/scans/ring/frames/kept-05.webp" ;
    rdfs:comment "Candidate 267, score 2,698, among the best frames of the video." .

ring:frame-kept-6 rdf:type ktype:Image ;
    rdfs:label "Kept frame at 50.00 s: the opposite side, low pass" ;
    p:photo "/scans/ring/frames/kept-06.webp" ;
    rdfs:comment "Candidate 351, score 1,116. The board is out of focus here, so the score reads low though the ring is acceptable." .

ring:frame-rejected-blur-1 rdf:type ktype:Image ;
    rdfs:label "Rejected for blur, at 9.62 s: moving to a top-down view" ;
    p:photo "/scans/ring/frames/rejected-blur-01.webp" ;
    rdfs:comment "Candidate 68, score 527. The move to the top-down view is motion-blurred for about 1.5 seconds, and 9 candidates there were rejected." .

ring:frame-rejected-blur-2 rdf:type ktype:Image ;
    rdfs:label "Rejected for blur, at 24.12 s: the focus drifted" ;
    p:photo "/scans/ring/frames/rejected-blur-02.webp" ;
    rdfs:comment "Candidate 170, score 941. The camera focused on the board instead of the ring, so the diamonds and engraving are soft." .

ring:frame-rejected-dup-1 rdf:type ktype:Image ;
    rdfs:label "Rejected as a near-duplicate, at 14.17 s" ;
    p:photo "/scans/ring/frames/rejected-duplicate-01.webp" ;
    rdfs:comment "Candidate 100, sharp (score 1,852) but almost the same view as its neighbour, so it adds nothing for the camera-position step." .

ring:frame-rejected-dup-2 rdf:type ktype:Image ;
    rdfs:label "Rejected as a near-duplicate, at 5.67 s" ;
    p:photo "/scans/ring/frames/rejected-duplicate-02.webp" ;
    rdfs:comment "Candidate 40, score 1,597, a smooth orbit with only a small change of angle from its neighbour." .

ring:pose-recovery rdf:type ktype:Concept ;
    rdfs:label "4. Recover where the camera was" ;
    rdfs:comment "COLMAP works out, for every kept frame, where the camera stood and where it pointed, by matching points between frames (sequential matching, each frame against its 10 neighbours, one shared camera model). All 189 of 189 frames were placed. This stage took 308.2 seconds. Done by a script." ;
    p:uses ring:colmap ;
    hnav:order "4"^^xsd:integer ;
    hnav:layer "1"^^xsd:integer ;
    hnav:prev  ring:frame-review ;
    hnav:next  ring:training .

ring:training rdf:type ktype:Concept ;
    rdfs:label "5. Train the splat" ;
    rdfs:comment "Brush fits a cloud of Gaussians (soft coloured blobs) so that, seen from each recovered camera, it looks like the matching frame. 30,000 training steps took 795.5 seconds, with seed 42. The result covers the ring and the board around it: 341,115 Gaussians before trimming. The pipeline also crops the result automatically, but that crop removed the ring itself (a bug, since fixed), so the next step started from the uncropped splat. Done by a script." ;
    p:uses ring:brush ;
    hnav:order "5"^^xsd:integer ;
    hnav:layer "1"^^xsd:integer ;
    hnav:prev  ring:pose-recovery ;
    hnav:next  ring:trim .

ring:trim rdf:type ktype:Concept ;
    rdfs:label "6. Trim the board away" ;
    rdfs:comment "A surface was fitted to the board locally, around a point on the ring that a person picked by eye. Only what stands above the surface near that point was kept, then the largest connected cluster. 341,115 Gaussians became 11,214. Known losses: about 5 percent of the ring's height is cut at the base (0.03 of 0.6 units), and some needle-like Gaussians remain at the edges. The fit is a script; PICKING THE POINT ON THE RING IS MANUAL." ;
    hnav:order "6"^^xsd:integer ;
    hnav:layer "1"^^xsd:integer ;
    hnav:prev  ring:training ;
    hnav:next  ring:orient-compress .

ring:orient-compress rdf:type ktype:Concept ;
    rdfs:label "7. Stand it upright and compress it" ;
    rdfs:comment "The trimmed splat was turned so the ring stands upright with the UNLV face toward the viewer, then compressed to the .spz format: about 290 KB (296,106 bytes), lossy, small enough to ship on a web page. Done by a script." ;
    hnav:order "7"^^xsd:integer ;
    hnav:layer "1"^^xsd:integer ;
    hnav:prev  ring:trim ;
    hnav:next  ring:show .

ring:show rdf:type ktype:Concept ;
    rdfs:label "8. Show it" ;
    rdfs:comment "The same file is shown here in Reckons.AI, where you can orbit it as a node, and on the Data Insight Solutions About page in a viewer that website hosts itself. Open the splat node below to orbit it." ;
    p:uses ring:ring-splat ;
    hnav:order "8"^^xsd:integer ;
    hnav:layer "1"^^xsd:integer ;
    hnav:prev  ring:orient-compress .

ring:what-is-manual rdf:type ktype:Concept ;
    rdfs:label "What is still manual, and what a script does" ;
    rdfs:comment "Scripts do: pulling candidate frames, scoring sharpness, camera-position recovery, training, the surface-fit trim, orienting and compressing. A person still does: filming, the frame-by-frame look that picks the 189 (step 3), and picking the point on the ring that the trim starts from (step 6). Nothing here decides by itself that a scan is good: the receipt records numbers and a person judges the picture." .

ring:open-frame-selection rdf:type ktype:Concept ;
    rdfs:label "Open question: can the frame selection be better?" ;
    p:open-question "The frame selection is being improved: a second reconstruction with better-chosen keyframes is being made and is NOT finished or compared yet. Until it is, the splat in this space comes from the 189 frames described above, and its limits (thin top-down coverage, no underside, tiny diamonds) stand." ;
    rdfs:comment "Whether better keyframes give a visibly better ring is not known yet; this space will say so when it is measured." .

ring:colmap rdf:type ktype:Concept ;
    rdfs:label "COLMAP (camera pose recovery)" ;
    rdfs:comment "Open-source structure-from-motion software. It finds the camera positions; it does not make the splat." .

ring:brush rdf:type ktype:Concept ;
    rdfs:label "Brush 0.3.0 (splat training)" ;
    rdfs:comment "Open-source Gaussian splat trainer, version brush-cli 0.3.0 as recorded in the receipt." .

ring:ring-splat rdf:type ktype:GaussianSplat ;
    rdfs:label "Splat: the ring (reconstructed)" ;
    p:splat "/scans/ring/ring.spz" ;
    kmeta:splat-origin "reconstructed" ;
    p:made-from ring:capture ;
    p:generated-with "COLMAP poses, Brush 0.3.0 training, local surface-fit trim" ;
    p:generated-gaussians "11214" ;
    p:generated-seed "42" ;
    p:generated-at "2026-11-12" ;
    rdfs:comment "RECONSTRUCTED from 189 photographs, not generated. 11,214 Gaussians, stored as .spz (about 290 KB, lossy), upright with the UNLV face toward the viewer. Limits: the underside was never filmed; about 5 percent of the height is lost at the base; needle-like edge Gaussians remain." .

ring:scan-your-own rdf:type ktype:Concept ;
    rdfs:label "Scan your own object" ;
    rdfs:comment "This is not only a story. On a computer with the tools, npm run scan:room turns a video or a folder of frames into a splat (COLMAP poses, Brush training, a receipt that records the numbers), and --check verifies a finished scan. Then, in the Graphs tab under space background, press Import a scan and pick the .ply or .spz file. The Your room example walks through the same steps for a room. A browser cannot run the training itself." ;
    p:uses ring:ring-splat .

ring:made-by rdf:type ktype:Concept ;
    rdfs:label "The same ring on the Data Insight Solutions website" ;
    rdfs:comment "The ring is also shown on the Data Insight Solutions About page, in a viewer that website hosts itself." ;
    <urn:reckons:leap> "https://data-insight.solutions/about/" ;
    <urn:reckons:leap/label> "Open the About page" .

story:ring-to-asset rdf:type story:Story ;
    rdfs:label "How this ring became a 3D asset" ;
    story:description "A ring filmed on a scan board becomes a 3D splat you can orbit, in eight steps with every number from the receipts. It is rebuilt from photographs, not generated by a model." ;
    story:autoplay "false" .

story:ring-step-capture rdf:type story:Step ;
    story:partOf story:ring-to-asset ;
    story:order "1"^^xsd:integer ;
    story:title "Film it on a board" ;
    story:content "One 53 second video, 4K at 120 frames per second, of the ring on a checkered scan board, from many angles. Open the video node to watch a 16 second clip of it. A person films." ;
    story:highlight ring:capture, ring:source-video .

story:ring-step-extract rdf:type story:Step ;
    story:partOf story:ring-to-asset ;
    story:order "2"^^xsd:integer ;
    story:title "Pull out candidate frames" ;
    story:content "A script cut the video into stills and kept the sharpest in each short window: 373 candidates, about 7 per second." ;
    story:highlight ring:extract-frames .

story:ring-step-frames rdf:type story:Step ;
    story:partOf story:ring-to-asset ;
    story:order "3"^^xsd:integer ;
    story:title "Keep the sharp frames" ;
    story:content "A person looked at all 373 and kept 189: sharp, and from differing angles. 54 were blurred and 130 repeated their neighbour. This look is still manual. Open the frame nodes to see kept and rejected ones." ;
    story:highlight ring:frame-review, ring:frames-contact-sheet, ring:frame-kept-2, ring:frame-rejected-blur-1 .

story:ring-step-poses rdf:type story:Step ;
    story:partOf story:ring-to-asset ;
    story:order "4"^^xsd:integer ;
    story:title "Recover where the camera was" ;
    story:content "COLMAP matched points between frames and placed the camera for all 189 of 189 frames in 308.2 seconds." ;
    story:highlight ring:pose-recovery, ring:colmap .

story:ring-step-train rdf:type story:Step ;
    story:partOf story:ring-to-asset ;
    story:order "5"^^xsd:integer ;
    story:title "Train the splat" ;
    story:content "Brush fitted a cloud of coloured blobs to the frames: 30,000 steps in 795.5 seconds, 341,115 Gaussians including the board. The pipeline's automatic crop removed the ring (a bug, since fixed), so the next step started from the uncropped splat." ;
    story:highlight ring:training, ring:brush .

story:ring-step-trim rdf:type story:Step ;
    story:partOf story:ring-to-asset ;
    story:order "6"^^xsd:integer ;
    story:title "Trim the board away" ;
    story:content "A surface was fitted to the board around a point on the ring picked by eye (manual), keeping the largest cluster: 341,115 Gaussians became 11,214. About 5 percent of the ring's height is lost at the base." ;
    story:highlight ring:trim .

story:ring-step-compress rdf:type story:Step ;
    story:partOf story:ring-to-asset ;
    story:order "7"^^xsd:integer ;
    story:title "Stand it up and compress it" ;
    story:content "The ring was turned upright with the UNLV face forward and compressed to .spz, about 290 KB." ;
    story:highlight ring:orient-compress .

story:ring-step-show rdf:type story:Step ;
    story:partOf story:ring-to-asset ;
    story:order "8"^^xsd:integer ;
    story:title "Show it" ;
    story:content "The same file is shown in Reckons.AI and on the Data Insight Solutions website. Open the splat node to orbit it, or see Scan your own object to do the same with yours. The frame selection is still being improved." ;
    story:highlight ring:show, ring:ring-splat, ring:scan-your-own, ring:open-frame-selection .
