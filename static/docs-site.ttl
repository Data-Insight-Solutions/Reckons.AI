@prefix rdf:   <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos:  <http://www.w3.org/2004/02/skos/core#> .
@prefix kb:    <urn:kbase:concept/> .
@prefix ktype: <urn:kbase:type/> .
@prefix page:  <urn:reckons:page/> .
@prefix hnav:  <urn:reckons:nav/> .

# =============================================================================
# docs-site.ttl — the SITE'S information architecture, as a graph (F27).
#
# WHY THIS FILE EXISTS. `scripts/docs-pages.ts` publishes one page per ENTITY: any subject with
# an rdf:type under urn:kbase:type/ becomes its own file. 269 entities therefore produce 269
# pages, alphabetical, with no editorial layer — /docs is ~23,000px of sidebar in which
# "6-Step Migration Pipeline" and "CONFLUENCE_MIGRATION.md -> Superseded" sit beside real
# documentation. "Has a type" was standing in for "is a page someone would want to read", so the
# graph was deciding the site's structure by accident.
#
# Here a PAGE is authored and DECLARES its sources, and composition gathers the matching entities
# into it (src/lib/publish/page-composition.ts). One page can source from SEVERAL graphs — the
# thing winner-takes-all resolveHomeFile() cannot express, since it awards each entity to one
# owning file and drops the other's assertions.
#
# EVERY PAGE MUST STATE ITS PURPOSE. Composition refuses a page without one, because a page
# nobody can state the point of is precisely what the 269 auto-generated pages already are.
#
# NOTHING IS SILENTLY DROPPED. Entities no page claims are reported as ORPHANS by
# `npm run docs:consolidate`. Curating 269 pages down to a dozen is an editorial act; doing it
# without that list would be data loss with a tidier sidebar.
#
# STATUS: this is a PROPOSED architecture, not the live one. The generator still publishes
# one-page-per-entity; wiring composition into it is a separate, reviewed change. Run
# `npm run docs:consolidate` to see exactly what this IA would cover and what it would leave out.
# =============================================================================

kb:docs-site a ktype:Concept ;
    rdfs:label "Docs site architecture" ;
    skos:definition "The pages the /docs site is composed of, each declaring which graphs it is made from." .

# -- 1. Start here -------------------------------------------------------------
kb:page-start a ktype:WebPage ;
    rdfs:label "Start here" ;
    page:slug "start-here" ;
    page:section "Docs" ;
    page:template "doc" ;
    page:status "draft" ;
    page:nav "sidebar" ;
    hnav:order "1" ;
    page:purpose "Get a graph on screen and a first fact into it. The only page a new reader needs." ;
    page:sources-graph "starter-guide.ttl" ;
    skos:broader kb:docs-site .

# -- 2. What it does -----------------------------------------------------------
kb:page-what-it-does a ktype:WebPage ;
    rdfs:label "What it does" ;
    page:slug "what-it-does" ;
    page:section "Docs" ;
    page:template "doc" ;
    page:status "draft" ;
    page:nav "sidebar" ;
    hnav:order "2" ;
    page:purpose "Every capability, and a worked example of each — what you can actually do with it." ;
    page:sources-graph "docs-features.ttl" ;
    page:sources-graph "docs-use-cases.ttl" ;
    skos:broader kb:docs-site .

# -- 3. How it works -----------------------------------------------------------
kb:page-how-it-works a ktype:WebPage ;
    rdfs:label "How it works" ;
    page:slug "how-it-works" ;
    page:section "Docs" ;
    page:template "doc" ;
    page:status "draft" ;
    page:nav "sidebar" ;
    hnav:order "3" ;
    page:purpose "Triples, graphs and the design decisions behind them — why the data is shaped this way." ;
    page:sources-graph "docs-triples-rdf.ttl" ;
    page:sources-graph "docs-architecture.ttl" ;
    skos:broader kb:docs-site .

# -- 4. Working with AI models -------------------------------------------------
kb:page-ai-models a ktype:WebPage ;
    rdfs:label "Working with AI models" ;
    page:slug "ai-models" ;
    page:section "Docs" ;
    page:template "doc" ;
    page:status "draft" ;
    page:nav "sidebar" ;
    hnav:order "4" ;
    page:purpose "What the models do here, what they are not trusted with, and how to run them locally." ;
    page:sources-graph "docs-llm.ttl" ;
    skos:broader kb:docs-site .

# -- 5. Connecting other systems -----------------------------------------------
kb:page-integrations a ktype:WebPage ;
    rdfs:label "Connecting other systems" ;
    page:slug "connecting-other-systems" ;
    page:section "Docs" ;
    page:template "doc" ;
    page:status "draft" ;
    page:nav "sidebar" ;
    hnav:order "5" ;
    page:purpose "Bringing your own tools in and getting your knowledge back out. Every integration is optional." ;
    page:sources-graph "docs-integrations-tech.ttl" ;
    skos:broader kb:docs-site .

# -- 6. Working safely ---------------------------------------------------------
kb:page-working-safely a ktype:WebPage ;
    rdfs:label "Working safely" ;
    page:slug "working-safely" ;
    page:section "Docs" ;
    page:template "doc" ;
    page:status "draft" ;
    page:nav "sidebar" ;
    hnav:order "6" ;
    page:purpose "Keeping a graph trustworthy: what stays on your machine, what leaves, and how facts get checked." ;
    page:sources-graph "docs-tips-security.ttl" ;
    skos:broader kb:docs-site .

# -- 7. Where it is going ------------------------------------------------------
kb:page-roadmap a ktype:WebPage ;
    rdfs:label "Where it is going" ;
    page:slug "where-it-is-going" ;
    page:section "Docs" ;
    page:template "doc" ;
    page:status "draft" ;
    page:nav "sidebar" ;
    hnav:order "7" ;
    page:purpose "The direction of the project and the ecosystem it sits in — what is built, and what is intended." ;
    page:sources-graph "docs-timeline-ecosystem.ttl" ;
    skos:broader kb:docs-site .

# -- 8. Contributing -----------------------------------------------------------
# Deliberately LAST and separate: the coding-workflow and testing graphs describe how this
# repository is developed. That is documentation for contributors, not for people using the
# product, and mixing the two is part of why the current sidebar reads as noise.
kb:page-contributing a ktype:WebPage ;
    rdfs:label "Contributing" ;
    page:slug "contributing" ;
    page:section "Docs" ;
    page:template "doc" ;
    page:status "draft" ;
    page:nav "sidebar" ;
    hnav:order "8" ;
    page:purpose "How this repository is developed and tested — for people changing the code, not using the app." ;
    page:sources-graph "docs-coding-workflow.ttl" ;
    page:sources-graph "docs-testing.ttl" ;
    skos:broader kb:docs-site .

# =============================================================================
# DELIBERATELY NOT PUBLISHED
#
# An EXCLUSION is not an orphan. An orphan is an entity nobody decided about, and it stays
# reported until someone does. An exclusion is a decision, and it carries its reason so the next
# person can tell whether it still holds. Composition REFUSES an exclusion with no reason.
# =============================================================================

kb:exclude-migration-tracker a ktype:Concept ;
    rdfs:label "Markdown migration tracker" ;
    page:excludes-under <urn:reckons:arch/MigrationStatus> ;
    page:purpose "Internal bookkeeping about which docs/*.md files in THIS repository have been migrated to TTL — entries like \"GUIDE.md -> Superseded\". Useful to a maintainer, meaningless to someone using Reckons.AI, and currently published as 16 public pages on /docs." ;
    skos:broader kb:docs-site .
