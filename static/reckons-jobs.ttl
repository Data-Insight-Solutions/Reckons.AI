    rdfs:label          "aggregate-decisions" ;
    skos:prefLabel      "aggregate-decisions" ;
    skos:definition     "F139.1 agent tier: a local model proposes which facts ONE question would settle, and which decisions block which. DISABLED until its yield is measured — enabling a proposal job whose precision is unknown moves cost to triage rather than removing it (F74.3). Run it manually with --limit and read the rejection reasons before turning it on." ;
    kpred:job-tier      "agent" ;
    kpred:command       "OLLAMA_BASE_URL=${OLLAMA_BASE_URL:-http://localhost:11434} npx tsx scripts/offline/aggregate-decisions.ts" ;
    kpred:job-enabled   "false" ;
    kpred:job-blocking  "false" .

