    kpred:job-enabled   "true" ;
    kpred:job-blocking  "false" .

job:tenet-align rdf:type          ktype:OfflineJob ;
    rdfs:label          "tenet-align" ;
    skos:prefLabel      "tenet-align" ;
    skos:definition     "Reads every roadmap feature against the tenets in kb:thesis and reports where they disagree: account pressure, closed-by-default dependencies, a store with no export, a 'functional' claim with no test or measurement, a status that outranks its own dependency, and tenets nothing is built against. Script tier and free, so it runs every session — an alignment check is only a habit if it costs nothing. Report-only: a rule cannot read intent, so the output is a reading list, never a verdict." ;
    kpred:job-tier      "script" ;
    kpred:command       "npx tsx scripts/offline/tenet-align.ts" ;
    kpred:job-enabled   "true" ;
    kpred:job-blocking  "false" .

job:untested-options rdf:type          ktype:OfflineJob ;
    rdfs:label          "untested-options" ;
    skos:prefLabel      "untested-options" ;
    skos:definition     "Optional inputs no test ever passes — the branch that only opens when someone sets the option. Found TurtleChatOptions.publishedMode (gates the published ethics wrapper) with zero coverage. Reports only." ;
    kpred:job-tier      "script" ;
    kpred:command       "npx tsx scripts/offline/untested-options.ts" ;
    kpred:job-enabled   "true" ;
    kpred:job-blocking  "false" .

job:visual-diff rdf:type          ktype:OfflineJob ;
    rdfs:label          "visual-diff" ;
    skos:prefLabel      "visual-diff" ;
    skos:definition     "Local-VLM visual regression prod↔dev (needs OLLAMA_BASE_URL; set VISUAL_DIFF_BASE / VISUAL_DIFF_HEAD)" ;
    kpred:job-tier      "agent" ;
    kpred:command       "npx tsx scripts/offline/visual-diff.ts --base=${VISUAL_DIFF_BASE:-https://reckons.ai} --head=${VISUAL_DIFF_HEAD:-https://dev.reckons-ai.pages.dev}" ;
    kpred:job-enabled   "false" ;
    kpred:job-blocking  "false" .

jobset:agent rdf:type      skos:Collection ;
    skos:prefLabel      "agent tier" ;
    skos:definition     "A local model inside a scripted harness — ground, prompt, validate, emit-proposal. Output is a PROPOSAL a human gates, never a write, because being wrong here has to be cheap." ;
    skos:member         job:aggregate-decisions, job:code-review, job:describe-entities, job:distill-decisions, job:docs-expand, job:docs-review, job:extraction-score, job:visual-diff .

jobset:script rdf:type      skos:Collection ;
    skos:prefLabel      "script tier" ;
    skos:definition     "Deterministic, zero tokens, no model. Right by construction and runs in CI. The work-tiering ladder says to grow this tier in preference to the others, and it is the larger one." ;
    skos:member         job:alignment-sweep, job:altitude-report, job:build-guard, job:button-crawl, job:claim-audit, job:code-sprawl, job:competitor-scan, job:context-composition, job:csp-origin-audit, job:dead-weight, job:docs-edits, job:docs-graph-registration, job:docs-staleness, job:extraction-chain, job:graph-economics, job:graph-lint, job:history-lessons, job:host-health, job:jobs-graph, job:landing-data, job:landing-data-align, job:perf-crawl, job:prompt-audit, job:proposal-yield, job:published-graph-guard, job:queue-dedupe, job:safety-attestation, job:scope-check, job:server-health, job:set-integrity, job:set-pages, job:shacl-validate, job:shared-deps, job:status-evidence, job:tenet-align, job:untested-options .

jobset:all rdf:type          skos:Collection ;
    skos:prefLabel      "Offline jobs" ;
    skos:definition     "Every job the offline sweep can run — 44 of them, 36 needing no model at all." ;
    skos:member         jobset:agent, jobset:script .
