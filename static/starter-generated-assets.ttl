## Generated assets — made on this machine by local models (F58.9, kb:splat-local-pipeline).
## WRITTEN BY scripts/content/gen-assets.ts FROM static/generated/*/receipt.json. Do not hand-edit;
## regenerate with `npm run gen:assets -- --ttl`. Every prompt is synthetic.

@prefix rdf:   <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix ktype: <urn:kbase:type/> .
@prefix kb:    <urn:kbase:concept/> .
@prefix p:     <urn:kbase:predicate/> .
@prefix schema: <https://schema.org/> .

## ktype:Prompt, Image, Video, GaussianSplat and License are built-in entity types (F58.9.5); no type is defined here.

kb:generated-assets rdf:type ktype:Concept ;
    rdfs:label "Generated on this machine" ;
    rdfs:comment "Pictures, clips and Gaussian splats made by local models from made-up prompts. Each one is linked to what it was made from, and carries the model, license and time its run recorded. A generated splat is invented from one picture: it is decoration, not a record of anything real." ;
    p:has kb:gen-carved-turtle-prompt, kb:gen-lighthouse-island-prompt .

kb:license-apache-2-0 rdf:type ktype:License ;
    rdfs:label "Apache-2.0" ;
    p:spdx-id "Apache-2.0" ;
    p:license-url "https://spdx.org/licenses/Apache-2.0.html" .

kb:license-mit rdf:type ktype:License ;
    rdfs:label "MIT" ;
    p:spdx-id "MIT" ;
    p:license-url "https://spdx.org/licenses/MIT.html" .

kb:gen-carved-turtle-prompt rdf:type ktype:Prompt ;
    rdfs:label "Prompt: Carved wooden sea turtle" ;
    rdfs:comment "A hand-carved wooden sea turtle figurine with a high domed shell painted with teal patterns, standing on its four flippers, three-quarter view from the front and slightly above, the whole figurine visible with its depth clear, studio product photo on a plain light grey background, soft even lighting" .

kb:gen-carved-turtle-image rdf:type ktype:Image ;
    rdfs:label "Image: carved wooden sea turtle" ;
    p:photo "/generated/carved-turtle/image.webp" ;
    p:made-from kb:gen-carved-turtle-prompt ;
    p:generated-with "Z-Image-Turbo (Q8) on stable-diffusion.cpp" ;
    schema:license kb:license-apache-2-0, kb:license-mit ;
    p:generated-duration "13.8 s" ;
    p:generated-seed "42" ;
    p:generated-at "2026-10-14" .

kb:gen-carved-turtle-video rdf:type ktype:Video ;
    rdfs:label "Video: carved wooden sea turtle" ;
    p:video "/generated/carved-turtle/video.webm" ;
    p:made-from kb:gen-carved-turtle-image ;
    p:generated-with "Wan2.2 TI2V-5B (Q8) on stable-diffusion.cpp" ;
