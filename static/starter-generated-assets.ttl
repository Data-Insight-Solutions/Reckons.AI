    schema:license kb:license-apache-2-0, kb:license-mit ;
    p:generated-duration "19.5 s" ;
    p:generated-seed "11" ;
    p:generated-at "2026-10-21" .

kb:gen-ornate-music-box-splat rdf:type ktype:GaussianSplat ;
