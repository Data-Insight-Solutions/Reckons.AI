## Generated assets — made on this machine by local models (F58.9, kb:splat-local-pipeline).
## WRITTEN BY scripts/content/gen-assets.ts FROM static/generated/*/receipt.json. Do not hand-edit;
## regenerate with `npm run gen:assets -- --ttl`. Every prompt is synthetic.

@prefix rdf:   <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix ktype: <urn:kbase:type/> .
@prefix kb:    <urn:kbase:concept/> .
@prefix p:     <urn:kbase:predicate/> .
@prefix schema: <https://schema.org/> .
@prefix story: <urn:reckons:story/> .
@prefix kmeta: <urn:kbase:meta/> .

## ktype:Prompt, Image, Video, GaussianSplat and License are built-in entity types (F58.9.5); no type is defined here.

kb:generated-assets rdf:type ktype:Concept ;
    rdfs:label "Generated on this machine" ;
    rdfs:comment "Pictures, clips and Gaussian splats made by local models from made-up prompts. Each one is linked to what it was made from, and carries the model, license and time its run recorded. A generated splat is invented from one picture: it is decoration, not a record of anything real." ;
    p:has kb:gen-carved-turtle-prompt, kb:gen-lighthouse-island-prompt, kb:gen-ornate-music-box-prompt, kb:gen-cad-l-bracket-60-spec .

story:create-generated-asset rdf:type story:Story ;
    rdfs:label "Create an asset with Shelly" ;
    story:description "Describe an image, generate it locally, then choose a video, Gaussian splat or another image." ;
    story:interaction "generate-assets" ;
    story:autoplay "false" .

story:generate-image rdf:type story:Step ;
    story:partOf story:create-generated-asset ;
    story:order "1" ;
    story:title "Imagine an image" ;
    story:content "Shelly asks for your image prompt and waits for the local runner to produce a checked result." ;
    story:question "What image would you like me to generate?" .

story:derive-asset rdf:type story:Step ;
    story:partOf story:create-generated-asset ;
    story:order "2" ;
    story:title "Choose what happens next" ;
    story:content "Once the image is ready, choose an available derivation. Each output links back to its source image." ;
    story:question "Would you like a video, a Gaussian splat, or another image?" .

kb:license-apache-2-0 rdf:type ktype:License ;
    rdfs:label "Apache-2.0" ;
    p:spdx-id "Apache-2.0" ;
    p:license-url "https://spdx.org/licenses/Apache-2.0.html" .

kb:license-mit rdf:type ktype:License ;
    rdfs:label "MIT" ;
    p:spdx-id "MIT" ;
    p:license-url "https://spdx.org/licenses/MIT.html" .

kb:gen-carved-turtle-prompt rdf:type ktype:Prompt ;
    rdfs:label "Prompt: Carved wooden sea turtle" ;
    rdfs:comment "A hand-carved wooden sea turtle figurine with a high domed shell painted with teal patterns, standing on its four flippers, three-quarter view from the front and slightly above, the whole figurine visible with its depth clear, studio product photo on a plain light grey background, soft even lighting" .

kb:gen-carved-turtle-image rdf:type ktype:Image ;
    rdfs:label "Image: carved wooden sea turtle" ;
    p:photo "/generated/carved-turtle/image.webp" ;
    p:made-from kb:gen-carved-turtle-prompt ;
    p:generated-with "Z-Image-Turbo (Q8) on stable-diffusion.cpp" ;
    schema:license kb:license-apache-2-0, kb:license-mit ;
    p:generated-duration "13.8 s" ;
    p:generated-seed "42" ;
    p:generated-at "2026-10-14" .

kb:gen-carved-turtle-video rdf:type ktype:Video ;
    rdfs:label "Video: carved wooden sea turtle" ;
    p:video "/generated/carved-turtle/video.webm" ;
    p:made-from kb:gen-carved-turtle-image ;
    p:generated-with "Wan2.2 TI2V-5B (Q8) on stable-diffusion.cpp" ;
    schema:license kb:license-apache-2-0, kb:license-mit ;
    p:generated-duration "52.6 s" ;
    p:generated-seed "42" ;
    p:generated-frames "49" ;
    rdfs:comment "the wooden sea turtle figurine swims forward, its flippers paddling up and down, the camera slowly circles around it, soft studio light" ;
    p:generated-at "2026-10-14" .

kb:gen-carved-turtle-splat rdf:type ktype:GaussianSplat ;
    rdfs:label "Splat: carved wooden sea turtle" ;
    p:splat "/generated/carved-turtle/splat.ply" ;
    p:made-from kb:gen-carved-turtle-image ;
    p:generated-with "TripoSplat" ;
    schema:license kb:license-mit ;
    p:generated-duration "33.8 s" ;
    p:generated-seed "42" ;
    p:generated-gaussians "32768" ;
    rdfs:comment "Invented from one picture by TripoSplat: the far side is a guess." ;
    p:generated-at "2026-10-14" .

kb:gen-lighthouse-island-prompt rdf:type ktype:Prompt ;
    rdfs:label "Prompt: Lighthouse island diorama" ;
    rdfs:comment "A miniature diorama of a small rocky island with a white and red lighthouse, a few pine trees and a wooden jetty, centered, whole island visible, isometric view, plain dark blue background, soft light" .

kb:gen-lighthouse-island-image rdf:type ktype:Image ;
