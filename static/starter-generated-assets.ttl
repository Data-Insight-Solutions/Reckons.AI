    rdfs:comment "the wooden sea turtle figurine swims forward, its flippers paddling up and down, the camera slowly circles around it, soft studio light" ;
    p:generated-at "2026-10-14" .

kb:gen-carved-turtle-splat rdf:type ktype:GaussianSplat ;
    rdfs:label "Splat: carved wooden sea turtle" ;
    p:splat "/generated/carved-turtle/splat.ply" ;
    p:made-from kb:gen-carved-turtle-image ;
    p:generated-with "TripoSplat" ;
    schema:license kb:license-mit ;
