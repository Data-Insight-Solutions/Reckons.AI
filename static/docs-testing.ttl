## =============================================================================
## Generation bench tasks (F183.2, kb:gen-bench-in-graph)
## =============================================================================
## A BenchTask is one generation stage (image, video, splat). Its briefs are ordered
## children (skos:broader the task, hnav:order); a brief's checklist items are ordered
## children of the brief. The ground truth lives here, in the graph, so that the
## benchmark corpus and its measured results are queryable (kb:tenet-evidence).
## scripts/content/gen-bench-graph.ts reads exactly this shape; a malformed task fails
## loudly. Everything is synthetic: no brief comes from anybody's notes.
##   bench:tier  smoke = easy, kept to catch a broken runner; hard = has headroom.
## The licence rule candidates are held to is kpred:principle on kb:gen-bench-in-graph.

@prefix bench: <urn:reckons:bench/> .
@prefix kb:    <urn:kbase:concept/> .

bench:BenchTask rdf:type rdfs:Class ; rdfs:label "Generation bench task" ;
    kpred:description "One generation stage with its fixed seeds and ordered briefs. The stage is image, video or splat." .
bench:Brief rdf:type rdfs:Class ; rdfs:label "Bench brief" ;
    kpred:description "One synthetic input for a stage, with a hand-written answer key: a yes/no checklist for images, numeric expectations for video and splat." .
bench:ChecklistItem rdf:type rdfs:Class ; rdfs:label "Checklist item" ;
    kpred:description "One yes/no question put to the local vision judge. The expected answer is always yes." .

bench:Task-image rdf:type bench:BenchTask ;
    rdfs:label "Image generation bench (text to image)" ;
    hnav:order 120 ;
    bench:stage "image" ;
    skos:broader test:TestSuite ;
    kpred:relates-to kb:gen-bench-in-graph ;
    bench:seed 101 ;
    bench:seed 202 ;
    bench:seed 303 .

bench:Task-video rdf:type bench:BenchTask ;
    rdfs:label "Video generation bench (image to video)" ;
    hnav:order 121 ;
    bench:stage "video" ;
    skos:broader test:TestSuite ;
    kpred:relates-to kb:gen-bench-in-graph ;
    bench:seed 101 ;
    bench:seed 202 ;
    bench:seed 303 .

bench:Task-splat rdf:type bench:BenchTask ;
    rdfs:label "Splat generation bench (image to splat)" ;
    hnav:order 122 ;
    bench:stage "splat" ;
    skos:broader test:TestSuite ;
    kpred:relates-to kb:gen-bench-in-graph ;
    bench:seed 101 ;
    bench:seed 202 ;
    bench:seed 303 .

