## ---------------------------------------------------------------------------
## Reckons.AI Docs — Test Suite & Visual Regression
## ---------------------------------------------------------------------------
## Test documentation as a knowledge graph. Each test scenario is a Story
## with ordered Steps. Screenshots attach to step nodes via kpred:icon2d.
## This proves that procedural documentation (step-by-step) works in TTL
## using the existing story:order vocabulary.
## ---------------------------------------------------------------------------

@prefix rdf:    <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:   <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos:   <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd:    <http://www.w3.org/2001/XMLSchema#> .
@prefix story:  <urn:reckons:story/> .
@prefix test:   <urn:reckons:test/> .
@prefix guide:  <urn:reckons:guide/> .
@prefix ktype:  <urn:kbase:type/> .
@prefix hnav:   <urn:reckons:nav/> .
@prefix kpred:  <urn:kbase:predicate/> .

test:GeneratedAssetStory rdf:type ktype:Concept ;
    rdfs:label "Interactive asset generation story" ;
    skos:broader test:TestSuite ;
    skos:definition "Open Generated assets, choose Create an asset with Shelly, enter a synthetic image prompt, and wait for a checked result before choosing a video or Gaussian splat. The browser tests drive an OPFS file-queue fixture using existing checked media; they do not run GPU models. They cover image-to-video-to-splat provenance, reopening and reload without duplicate jobs/assets, failed-image retry, cancellation, corruption refusal, unavailable derivations and a space switch during generation. Protocol and runner unit tests reject command/path injection, inconsistent receipts, cross-space dependencies, stale heartbeats and interrupted-job replay." ;
    kpred:command "npx playwright test tests/e2e/generated-assets-story.test.ts --project=desktop-chrome --project=mobile-android" ;
    kpred:honest-note "Real generation requires a separate local run with installed tools/models and a private workspace. File checks establish decodability and structural validity, not artistic quality. Browser fixtures are not evidence of a GPU run." ;
    kpred:tested-by "tests/e2e/generated-assets-story.test.ts" ;
    kpred:tested-by "src/lib/generation/__tests__/protocol.test.ts" ;
    kpred:tested-by "scripts/content/__tests__/generation-runner.test.ts" .

