@prefix p:     <urn:kbase:predicate/> .
@prefix kmeta: <urn:kbase:meta/> .
@prefix hnav:  <urn:reckons:nav/> .
@prefix rev:   <urn:reckons:review/0.2.6/> .

rev:release rdf:type ktype:Concept ;
    rdfs:label "Review v0.2.6" ;
    rdfs:comment "The visual tests of v0.2.6, in the order a person would review them. 1 of this release's 15 parts have a TestWorkflow (5 steps, each a screenshot and what the test checks); 14 do not yet, and are listed under \"No visual test yet\" so the gap stays visible. Select a step, look at its picture, and set pass, fail or a note in the node panel. Generated from the roadmap and the Testing graph by scripts/offline/release-review-space.ts; edit those, not this file. Release status when generated: planned." ;
    hnav:order "0"^^xsd:integer ;
    hnav:layer "0"^^xsd:integer ;
    p:has rev:wf-readme-path, rev:gap .

rev:wf-readme-path rdf:type ktype:Concept ;
    rdfs:label "1. Add a source, review it, see it in a space, ask for a reckoning" ;
    rdfs:comment "Part of v0.2.6: F34.2 Test workflows — each end-to-end path as a diagram, step text, an annotated screenshot per step and the assertion it checks (status: in-progress). The path the README describes, start to finish: put a short note into Reckons.AI, settle the claims it proposes, find them in your space, and ask for a reckoning that works from what you settled. It is the whole point of the product in five steps, and a browser test runs it on every change. Run by tests/e2e/workflow-readme-path.test.ts." ;
    hnav:order "1"^^xsd:integer ;
    hnav:layer "1"^^xsd:integer ;
    hnav:next rev:gap ;
    p:has rev:wf-readme-path-01-add-source, rev:wf-readme-path-02-review-claims, rev:wf-readme-path-03-confirm-claims, rev:wf-readme-path-04-see-in-space, rev:wf-readme-path-05-reckoning .

rev:wf-readme-path-01-add-source rdf:type ktype:Concept ;
    rdfs:label "1. Add a source" ;
    rdfs:comment "Open the Add tab, give the note a title, type or paste in a few sentences and press Extract facts. Reckons.AI reads the text and proposes claims from it. Nothing is accepted yet: every claim arrives waiting for your decision.\n\nWhere: the Add tab (/ingest).\n\nThe test checks: The Extract facts button is enabled once a title and text are entered, and pressing it takes the person off the Add tab when reading finishes. The test's stand-in reader returns placeholder claims at this point." ;
    p:photo "/workflows/readme-path/01-add-source.webp" ;
    hnav:order "1"^^xsd:integer ;
    hnav:layer "2"^^xsd:integer ;
    hnav:next rev:wf-readme-path-02-review-claims ;
    kmeta:review-verdict "unreviewed" .

rev:wf-readme-path-02-review-claims rdf:type ktype:Concept ;
    rdfs:label "2. Review the proposed claims" ;
    rdfs:comment "Open Review. Each claim waiting for a decision is a card. It names where the claim came from, shows the passage it was taken from, and offers accept, refine and reject. AI can misread what it reads, so this is where you check what it proposed against the original text.\n\nWhere: the Review tab (/review).\n\nThe test checks: At least one claim is waiting on the Review tab, shown as a card with accept, refine and reject buttons." ;
    p:photo "/workflows/readme-path/02-review-claims.webp" ;
    hnav:order "2"^^xsd:integer ;
    hnav:layer "2"^^xsd:integer ;
    hnav:next rev:wf-readme-path-03-confirm-claims ;
    hnav:prev rev:wf-readme-path-01-add-source ;
    kmeta:review-verdict "unreviewed" .

rev:wf-readme-path-03-confirm-claims rdf:type ktype:Concept ;
    rdfs:label "3. Confirm the claims that are right" ;
    rdfs:comment "Press accept on each claim that matches its source. You can also refine a claim or reject it. Only claims you confirm become part of the space; anything left waiting stays out.\n\nWhere: the Review tab (/review).\n\nThe test checks: Pressing accept settles the claims one by one until none of them is left waiting for a decision." ;
    p:photo "/workflows/readme-path/03-confirm-claims.webp" ;
    hnav:order "3"^^xsd:integer ;
    hnav:layer "2"^^xsd:integer ;
    hnav:next rev:wf-readme-path-04-see-in-space ;
    hnav:prev rev:wf-readme-path-02-review-claims ;
    kmeta:review-verdict "unreviewed" .

rev:wf-readme-path-04-see-in-space rdf:type ktype:Concept ;
    rdfs:label "4. See the claims in your space" ;
    rdfs:comment "Open Spaces. The claims you confirmed are now facts in your space, the collection of connected knowledge that everything you add feeds. The one you are working in is marked current, and its card says how many facts it holds.\n\nWhere: the Spaces tab (/kb).\n\nThe test checks: The Spaces tab shows the current one with more facts than it held before the claims were confirmed." ;
    p:photo "/workflows/readme-path/04-see-in-space.webp" ;
    hnav:order "4"^^xsd:integer ;
    hnav:layer "2"^^xsd:integer ;
    hnav:next rev:wf-readme-path-05-reckoning ;
    hnav:prev rev:wf-readme-path-03-confirm-claims ;
    kmeta:review-verdict "unreviewed" .

rev:wf-readme-path-05-reckoning rdf:type ktype:Concept ;
    rdfs:label "5. Ask for a reckoning" ;
    rdfs:comment "Describe the situation you are in, say what you want to reach, and ask for a reckoning. It reads the facts in your space and proposes options and a recommendation, which you then weigh yourself. It is a proposal to evaluate, not an answer to trust.\n\nWhere: the Reckon tab (/reckoning).\n\nThe test checks: The request is accepted and a proposal card comes back saying how many facts it is based on. The reply in this run is scripted, written to read like a real reckoning about the Getting started notes; the test does not judge a real model's wording, which is measured separately." ;
    p:photo "/workflows/readme-path/05-reckoning.webp" ;
    hnav:order "5"^^xsd:integer ;
    hnav:layer "2"^^xsd:integer ;
    hnav:prev rev:wf-readme-path-04-see-in-space ;
    kmeta:review-verdict "unreviewed" .

