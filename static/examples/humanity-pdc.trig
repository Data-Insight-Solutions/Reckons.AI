# Humanity AI, PDC and Reckons.AI — a sourced, reviewable example.
# Authoring source. Generate the app's lossless Turtle with:
#   npx tsx scripts/examples/build-humanity-pdc.ts
# Checked 2026-09-15. Named graphs distinguish public sources, user background,
# working-tree capabilities, and proposals. All imported statements await review.
# No PDC records, credentials, employer endorsements or grant commitments are included.

@prefix kb: <urn:kbase:concept/> .
@prefix kpred: <urn:kbase:predicate/> .
@prefix ktype: <urn:kbase:type/> .
@prefix kmeta: <urn:kbase:meta/> .
@prefix src: <urn:kbase:source/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix dc: <http://purl.org/dc/terms/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix story: <urn:reckons:story/> .

# Source catalogue (metadata, outside the named content graphs).
src:humanity-overview dc:title "Humanity AI — initiative overview" ; kmeta:sourceUri "https://humanityai.ai/what-we-do/" .
src:humanity-call dc:title "Humanity AI — 2026 open call" ; kmeta:sourceUri "https://humanityai.ai/open-call/" .
src:pdc-about dc:title "PDC — purpose and community" ; kmeta:sourceUri "https://philanthropydatacommons.org/about/" .
src:pdc-architecture dc:title "PDC — documented architecture" ; kmeta:sourceUri "https://philanthropydatacommons.org/howitworks/architecture/" .
src:pdc-consent dc:title "PDC — consent and data use" ; kmeta:sourceUri "https://philanthropydatacommons.org/learn-more/consent/" .
src:pdc-service dc:title "PDC — public service repository" ; kmeta:sourceUri "https://github.com/PhilanthropyDataCommons/service" .
src:pdc-permissions dc:title "PDC — data permissions" ; kmeta:sourceUri "https://github.com/PhilanthropyDataCommons/service/blob/main/docs/PERMISSIONS.md" .
src:user-background dc:title "User-confirmed background — 2026-09-15" ; kmeta:sourceUri "urn:reckons:reference/user-statement-2026-09-15" .
src:earlier-draft dc:title "Earlier humanity-ai-call graph — proposal context" ; kmeta:sourceUri "urn:reckons:reference/humanity-ai-call-draft" .
src:reckons-code dc:title "Reckons.AI — inspected local implementation, 2026-09-15" ; kmeta:sourceUri "urn:reckons:reference/local-working-tree-2026-09-15" .
src:explorer-proposal dc:title "Proposal — PDC exploration and community governance" ; kmeta:sourceUri "urn:reckons:proposal/pdc-exploration-2026-09-15" .
src:example-guide dc:title "Example guide — authored walkthrough" ; kmeta:sourceUri "urn:reckons:example/humanity-pdc-guide" .

src:humanity-overview {
  kb:humanity-ai a ktype:Organization ; rdfs:label "Humanity AI" ;
    dc:description "A collaborative philanthropic initiative supporting people’s influence over AI." ;
    kpred:funding "USD 500 million initiative" ;
    kpred:website <https://humanityai.ai/what-we-do/> ;
    kpred:offers kb:humanity-ai-call .
}

# Concise paraphrase of the call. This call's scope is narrower than the whole initiative.
src:humanity-call {
  kb:humanity-ai-call a ktype:Opportunity ; rdfs:label "Communities Leading on AI — 2026 call" ;
    kpred:funding "USD 10 million total; awards USD 75,000–1,000,000" ;
    kpred:deadline "2026-10-21T16:59:00-07:00"^^xsd:dateTime ;
    kpred:duration "Up to three years" ;
    kpred:requires kb:eligible-lead, kb:community-leadership ;
    kpred:focus kb:education, kb:labor-economy, kb:arts-culture ;
    kpred:approach "Community governance, community-built AI, or challenges to imposed AI" ;
    kpred:priority "Open-weight/open-source models receive preference when models are central" ;
    kpred:constraint "Tool adoption, AI literacy, and research alone are outside scope" ;
    kpred:criteria "Vision; community leadership; feasibility; impact; credibility" ;
    kpred:website <https://humanityai.ai/open-call/> .
  kb:eligible-lead a ktype:Concept ; rdfs:label "Eligible lead or fiscal sponsor" ;
    dc:description "U.S. nonprofit lead or sponsor; qualifying Tribal governments also eligible. For-profit collaborators cannot lead." .
  kb:community-leadership a ktype:Concept ; rdfs:label "Community decision-making power" ;
    dc:description "Affected U.S. communities define goals and shape the work." .
  kb:education a ktype:Concept ; rdfs:label "Education" .
  kb:labor-economy a ktype:Concept ; rdfs:label "Labor and economy" .
  kb:arts-culture a ktype:Concept ; rdfs:label "Humanities, arts and culture" .
}

src:pdc-about {
  kb:philanthropy-data-commons a ktype:Organization ; rdfs:label "Philanthropy Data Commons (PDC)" ;
    dc:description "Sector-governed open-source infrastructure connecting philanthropic data across existing systems." ;
    kpred:serves kb:changemakers, kb:funders, kb:data-partners ;
    kpred:goal "Reduce repeated data entry and support reuse of permissioned organizational information." ;
    kpred:website <https://philanthropydatacommons.org/about/> .
  kb:changemakers a ktype:Concept ; rdfs:label "Changemakers and nonprofits" .
  kb:funders a ktype:Concept ; rdfs:label "Funders" .
  kb:data-partners a ktype:Concept ; rdfs:label "Platforms and data partners" .
}

src:pdc-architecture {
  kb:philanthropy-data-commons kpred:uses kb:pdc-api .
  kb:pdc-api a ktype:Tool ; rdfs:label "PDC API — documented integration point" ;
    dc:description "PDC’s API connects clients to its data and file stores, authentication and access controls." ;
    kpred:supports kb:pdc-client-apps ;
    kpred:website <https://philanthropydatacommons.org/howitworks/architecture/> .
  kb:pdc-client-apps a ktype:Concept ; rdfs:label "PDC-connected applications" ;
    dc:description "Third-party clients can use the API; Exchange is an existing PDC application." .
}

src:pdc-service {
  kb:pdc-api kpred:provides kb:pdc-opportunity, kb:pdc-proposal, kb:pdc-field-mapping ;
    kpred:website <https://github.com/PhilanthropyDataCommons/service> .
  kb:pdc-opportunity a ktype:Concept ; rdfs:label "PDC opportunity records" ;
    dc:description "Calls and the fields used to collect responses." .
  kb:pdc-proposal a ktype:Concept ; rdfs:label "PDC proposal records" ;
    dc:description "Responses associated with opportunities." ; kpred:responds-to kb:pdc-opportunity .
  kb:pdc-field-mapping a ktype:Concept ; rdfs:label "PDC field mappings" ;
    dc:description "Mappings connect different organizations’ field names with PDC representations." .
}

src:pdc-permissions {
  kb:pdc-api kpred:requires kb:pdc-access .
  kb:pdc-access a ktype:Concept ; rdfs:label "PDC identity and data permissions" ;
    dc:description "Keycloak handles identity. PDC grants data permissions to users and groups referenced by UUID." ;
    kpred:website <https://github.com/PhilanthropyDataCommons/service/blob/main/docs/PERMISSIONS.md> .
}

src:pdc-consent {
  kb:philanthropy-data-commons kpred:requires kb:pdc-consent .
  kb:pdc-consent a ktype:Concept ; rdfs:label "PDC consent and data-use terms" ;
    dc:description "PDC describes informed owner permission and use governed by its data-use agreement." ;
    kpred:website <https://philanthropydatacommons.org/learn-more/consent/> .
}

# User's own statement, not an assertion by Submittable or PDC.
src:user-background {
  kb:reckons-builder a ktype:Person ; rdfs:label "Reckons.AI builder — pilot experience" ;
    kpred:experience "Worked on a PDC pilot while employed by Submittable; now building open-source Reckons.AI." ;
    kpred:builds kb:reckons-ai ; kpred:worked-at kb:submittable ;
    kpred:honest-note "Self-reported by the user on 2026-09-15. This records experience, not an employer endorsement or current partnership." .
  kb:submittable a ktype:Organization ; rdfs:label "Submittable — previous employer" .
  kb:people-first-ai a ktype:Concept ; rdfs:label "VISION: local AI in people's hands" ;
    dc:description "The builder wants Reckons.AI to make local AI useful for everyday learning, research and personal assistance. People begin with their own notes and choose how knowledge is organized and shared." ;
    kpred:uses kb:personal-notes, kb:local-model-support ;
    kpred:honest-note "Product intent expressed by the user. Wider access, learning outcomes and community benefit must be evaluated with users." .
}

src:earlier-draft {
  kb:earlier-humanity-draft a ktype:Concept ; rdfs:label "Earlier Humanity AI application graph" ;
    dc:description "The existing draft explores shared grant analysis and a local food-economy coverage map. These remain candidate pilot settings." ;
    kpred:proposes kb:grant-analysis, kb:local-food-example ;
    kpred:honest-note "Earlier uncertainty about public PDC documentation is updated by the architecture, service and permissions sources in this example. Live access still needs agreement." .
  kb:local-food-example a ktype:Concept ; rdfs:label "Local food collaboration — earlier pilot idea" ;
    dc:description "Use the earlier draft to discuss volunteer coordination, growers’ work and gaps in services. Participants, baseline evidence and consent still need confirmation." .
}

src:reckons-code {
  kb:reckons-ai a ktype:Tool ; rdfs:label "Reckons.AI — open-source personal graph" ;
    kpred:license "MIT (application repository)" ;
    kpred:website <https://github.com/Data-Insight-Solutions/Reckons.AI> ;
    kpred:provides kb:personal-notes, kb:reviewed-copy, kb:graph-exploration, kb:local-model-support, kb:mcp-context ;
    kpred:honest-note "These capabilities were inspected in the local working tree. Notes routing is locally tested and not deployed; no live PDC connector is implemented." .
  kb:personal-notes a ktype:Tool ; rdfs:label "Personal Notes — built locally" ;
    dc:description "Save and search original text without extraction. Browser IndexedDB stores the graph; a linked workspace can export lossless Turtle." ;
    kpred:has-file "src/lib/storage/personal-notes.ts" .
  kb:reviewed-copy a ktype:Tool ; rdfs:label "Reviewed graph copies — built locally" ;
    dc:description "Allow a local destination, review the outgoing text and approve a copy. Originals stay in Personal Notes; retries preserve provenance and avoid duplicates." ;
    kpred:constraint "Permissions and transfer receipts are browser-local; they are not PDC access controls or publication authorization." ;
    kpred:has-file "src/lib/rdf/personal-notes.ts" .
  kb:graph-exploration a ktype:Tool ; rdfs:label "Graph exploration and source inspection" ;
    dc:description "Explore entities and relationships, inspect sources and review individual statements." ;
    kpred:has-file "src/lib/components/SourcesExplorer.svelte" .
  kb:local-model-support a ktype:Tool ; rdfs:label "Configured local-model support" ;
    dc:description "Reckons supports configured Ollama backends and task choices. Model and hardware suitability require testing; local inference is not a guarantee of accuracy." ;
    kpred:has-file "src/lib/integrations/llm/prefer-local.ts" .
  kb:mcp-context a ktype:Tool ; rdfs:label "Graph context through MCP" ;
    dc:description "The MCP server exposes graph search, entity lookup and compact context to compatible agents." ;
    kpred:constraint "The existing MCP workspace is not a multi-user PDC authorization boundary." ;
    kpred:has-file "mcp-server/README.md" .
  kb:entity-alignment a ktype:Tool ; rdfs:label "Built: compare and align graph entities" ;
    dc:description "Cross-graph alignment uses shared identifiers and embedding suggestions to compare claims. Accepted suggestions enter review as pending statements." ;
    kpred:has-file "src/lib/rdf/cross-kb-align.ts" ;
    kpred:honest-note "Entity matching is not grant eligibility assessment. The guided grant workflow and requirement-level explanations below are authored examples, not an implemented automated grant checker." .
}

src:explorer-proposal {
  kb:local-learning a ktype:Concept ; rdfs:label "EXAMPLE: learn from your own materials" ;
    dc:description "Keep class notes, voice questions and selected readings together. Ask a configured local model to explain a concept or suggest connections; check its response against the original material and record unresolved questions." ;
    kpred:uses kb:personal-notes, kb:local-model-support, kb:graph-exploration ;
    kpred:output kb:seeker-graph .
  kb:local-research a ktype:Concept ; rdfs:label "EXAMPLE: investigate with visible evidence" ;
    dc:description "Bring research notes and permitted documents into a graph. Compare claims, find contradictory accounts and inspect evidence behind a proposed answer. Share only the portion a person reviews." ;
    kpred:uses kb:graph-exploration, kb:human-review, kb:mcp-context .
  kb:accessible-local-ai a ktype:Concept ; rdfs:label "PROPOSED: make local AI practical to use" ;
    dc:description "Let people choose their model and task, reuse their own knowledge and take their data with them. Try smaller models on bounded tasks and larger models where needed. Provide understandable controls and measure usefulness on participants' actual devices." ;
    kpred:implements kb:people-first-ai ;
    kpred:supports kb:local-learning, kb:local-research ;
    kpred:constraint "Local inference needs suitable hardware and setup. A web interface alone does not give every device a local model, guarantee privacy for external calls or demonstrate equitable access." .
  kb:opportunity-graph a ktype:Concept ; rdfs:label "INPUT A: the grant opportunity graph" ;
    dc:description "The public call's requirements, issue areas, deadline and award range, each with its source. Exported separately as example-humanity-opportunity.ttl." ;
    kpred:includes kb:humanity-ai-call, kb:eligible-lead, kb:community-leadership ;
    kpred:next kb:merge-for-alignment .
  kb:seeker-graph a ktype:Concept ; rdfs:label "INPUT B: the grant seeker's graph" ;
    dc:description "The builder's stated experience and purpose, inspected Reckons capabilities and proposed learning, research and PDC work. Exported separately as example-reckons-seeker.ttl. Proposed outcomes remain proposals; an eligible applicant is not established." ;
    kpred:includes kb:reckons-builder, kb:reckons-ai, kb:people-first-ai, kb:accessible-local-ai ;
    kpred:next kb:merge-for-alignment .
  kb:merge-for-alignment a ktype:Concept ; rdfs:label "WORKFLOW: review a merge into an assessment graph" ;
    dc:description "Bring copies of the opportunity and seeker graphs into a third working graph. Review suggested entity and vocabulary matches; retain both sources when claims agree and retain disagreements when they conflict. Keep both input graphs intact." ;
    kpred:input kb:opportunity-graph, kb:seeker-graph ;
    kpred:uses kb:entity-alignment, kb:human-review ;
    kpred:output kb:alignment-graph ;
    kpred:honest-note "A proposed workflow using existing comparison primitives. This example's combined graph preserves source identity, but a single guided grant-merge action is not built." .
  kb:alignment-graph a ktype:Concept ; rdfs:label "OUTPUT: a sourced alignment working graph" ;
    dc:description "Connect each requirement to supporting evidence, counterevidence or an explicit unknown. Merging makes evidence available together; it does not make the seeker eligible or turn a proposal into an achieved outcome." ;
    kpred:includes kb:alignment-potential, kb:alignment-eligibility, kb:alignment-community ;
    kpred:next kb:alignment-review .
  kb:alignment-potential a ktype:Concept ; rdfs:label "ILLUSTRATIVE: promising technical fit" ;
    kpred:status "partial support; human assessment needed" ;
    kpred:requirement kb:humanity-ai-call ;
    kpred:evidence kb:reckons-ai, kb:local-model-support, kb:reckons-builder ;
    dc:description "An open-source tool, local-model choices and relevant pilot experience provide material for a technical case. They do not establish community leadership, a funded partnership or results." .
  kb:alignment-eligibility a ktype:Concept ; rdfs:label "ILLUSTRATIVE: applicant eligibility unknown" ;
    kpred:status "unknown" ; kpred:requirement kb:eligible-lead ;
    kpred:open-question "Which eligible organization will lead or fiscally sponsor this application?" ;
    kpred:next kb:lead-question .
  kb:alignment-community a ktype:Concept ; rdfs:label "ILLUSTRATIVE: community authority still needs evidence" ;
    kpred:status "proposed; not demonstrated" ; kpred:requirement kb:community-leadership ;
    kpred:evidence kb:community-panel ;
    dc:description "The design proposes paid community decision-making. Document actual participants, agreements and decision rights before claiming this requirement is met." ;
    kpred:next kb:community-question .
  kb:alignment-review a ktype:Concept ; rdfs:label "WORKFLOW: review the alignment, then act" ;
    dc:description "Ask a chosen model to draft requirement-by-requirement explanations with evidence links, mismatches and unknowns. A person checks the source and records a decision or follow-up question. Export a reviewed application brief; keep model output pending." ;
    kpred:uses kb:slm-role, kb:llm-role, kb:human-review ;
    kpred:next kb:funding-hypothesis ;
    kpred:constraint "No similarity score is a funding probability. These assessment nodes are hand-authored illustrations; no grant-specific evaluator has run." .
  kb:pdc-explorer-proposal a ktype:Concept ; rdfs:label "PROPOSAL: Reckons as a PDC explorer" ;
    kpred:has-status "planned" ;
    dc:description "Co-design an exploratory graph interface with nonprofit workers and volunteers, using only records they are authorized to inspect." ;
    kpred:uses kb:reckons-ai, kb:pdc-api ;
    kpred:depends-on kb:community-panel, kb:permission-aware-adapter, kb:pilot-evaluation ;
    kpred:targets kb:labor-economy ;
    kpred:supports kb:grant-analysis, kb:gap-analysis, kb:local-research ;
    kpred:honest-note "A funding hypothesis and demonstrator design. No PDC integration, endorsement, grant award or partner commitment is asserted." .
  kb:community-panel a ktype:Concept ; rdfs:label "PROPOSED: community decisions" ;
    dc:description "Pay participating nonprofit workers and volunteers to choose the questions, permitted data uses, useful outputs and stop conditions. Give them authority over the pilot roadmap." ;
    kpred:implements kb:community-leadership .
  kb:permission-aware-adapter a ktype:Concept ; rdfs:label "PROPOSED: authorized PDC read adapter" ;
    dc:description "Start with authorized API reads. Preserve PDC record identifiers, origin, retrieval time and field mappings in the graph. Keep inferred links separate from supplied records." ;
    kpred:uses kb:pdc-access, kb:pdc-field-mapping ;
    kpred:requires kb:access-question, kb:cache-policy ;
    kpred:output kb:authorized-records .
  kb:cache-policy a ktype:Concept ; rdfs:label "DESIGN NEEDED: cache and permission changes" ;
    dc:description "Choose retention and freshness rules with PDC. Re-check authorization before new reads or agent context, and stop serving expired or revoked data. Downloaded copies cannot be retroactively erased by a promise." .
  kb:authorized-records a ktype:Concept ; rdfs:label "PROPOSED: authorized source graph" ;
    dc:description "An explorable projection of accessible records, with links back to their sources. A missing record may be restricted; absence does not prove a gap in funding." ;
    kpred:input kb:pdc-opportunity, kb:pdc-proposal ;
    kpred:next kb:model-proposals .
  kb:model-proposals a ktype:Concept ; rdfs:label "PROPOSED: AI interpretations" ;
    dc:description "Models propose normalized names, relationships and explanations against retrieved evidence. People review them; an inferred match is never a funding commitment." ;
    kpred:uses kb:slm-role, kb:llm-role ; kpred:next kb:human-review .
  kb:slm-role a ktype:Concept ; rdfs:label "PROPOSED: small language model tasks" ;
    dc:description "Evaluate compact local models on bounded extraction, topic tagging and field-mapping suggestions. Measure correction effort, latency, memory and groundedness on the community’s examples." ;
    kpred:requires kb:pilot-evaluation, kb:model-rights .
  kb:llm-role a ktype:Concept ; rdfs:label "PROPOSED: larger language model tasks" ;
    dc:description "Evaluate larger models for complex cross-record explanations and ambiguous mappings. Prefer suitable open models; permit external inference only for explicitly approved data and destinations." ;
    kpred:requires kb:pilot-evaluation, kb:model-rights .
  kb:model-rights a ktype:Concept ; rdfs:label "PROPOSED: model and data-use decisions" ;
    dc:description "Inspect each model’s license, hosting and data handling. Open weights alone do not establish an open-source license. Permission to read data does not automatically permit training or public release." .
  kb:human-review a ktype:Concept ; rdfs:label "PROPOSED: review evidence and outgoing changes" ;
    dc:description "Compare the source record with each proposed relationship or correction. Approve an exact destination-specific snapshot. Keep disagreements and source versions visible." ;
    kpred:uses kb:reviewed-copy ; kpred:next kb:organization-graph .
  kb:organization-graph a ktype:Concept ; rdfs:label "PROPOSED: organization knowledge graph" ;
    dc:description "Combine reviewed organizational notes with permitted PDC references. Personal notes enter only through approved copies." ;
    kpred:input kb:personal-notes ;
    kpred:next kb:pdc-writeback, kb:public-release .
  kb:pdc-writeback a ktype:Concept ; rdfs:label "FUTURE: approved PDC write-back" ;
    dc:description "A later adapter could map approved changes to permitted API mutations with conflict previews and durable receipts. The local copy feature does not implement this." ;
    kpred:requires kb:pdc-consent, kb:pdc-access ; kpred:has-status "planned" .
  kb:public-release a ktype:Concept ; rdfs:label "PROPOSED: separately approved open data" ;
    dc:description "Publish only material with explicit release permission and suitable rights. Review identifying details, choose the license and retain provenance. PDC participation alone does not authorize public redistribution." ;
    kpred:requires kb:human-review, kb:model-rights .
  kb:grant-analysis a ktype:Concept ; rdfs:label "EXAMPLE QUESTION: why might this opportunity fit?" ;
    dc:description "Connect call requirements with reviewed organizational aims and evidence. Show unmet requirements, uncertain matches and the source of each explanation." ;
    kpred:uses kb:humanity-ai-call, kb:authorized-records, kb:merge-for-alignment .
  kb:gap-analysis a ktype:Concept ; rdfs:label "EXAMPLE QUESTION: where is coordination missing?" ;
    dc:description "Explore complementary work and possible overlaps across authorized records. Ask participants what apparent gaps mean before drawing conclusions." ;
    kpred:uses kb:local-food-example, kb:authorized-records .
  kb:pilot-evaluation a ktype:Concept ; rdfs:label "PROPOSED: measure usefulness and control" ;
    dc:description "Compare manual work, an SLM route and a larger-model route on the same consented tasks. Report citation accuracy, mistaken links, reviewer effort, time saved and access-control failures." ;
    kpred:constraint "Publish measured results with limitations. Do not claim cost savings, better matches or community benefit before testing." .
  kb:funding-hypothesis a ktype:Concept ; rdfs:label "HYPOTHESIS: Humanity AI could fund this pilot" ;
    dc:description "A community-led proposal could resource co-design, an open PDC adapter, evaluation and reusable governance practices using Reckons.AI. Fit depends on actual community leadership and a credible implementation plan." ;
    kpred:targets kb:humanity-ai-call ; kpred:uses kb:pdc-explorer-proposal ;
    kpred:requires kb:lead-question, kb:community-question, kb:access-question, kb:scope-question ;
    kpred:has-status "planned" .
  kb:lead-question a ktype:Question ; rdfs:label "OPEN: who is the eligible lead or sponsor?" ;
    kpred:asks-about kb:eligible-lead ;
    dc:description "Confirm an eligible lead, its agreement, responsibilities and any existing Humanity AI funding before representing application eligibility." .
  kb:community-question a ktype:Question ; rdfs:label "OPEN: which community will direct the work?" ;
    kpred:asks-about kb:community-panel ;
    dc:description "Choose the participating community, document relationships and specify its authority and compensation. Earlier local-food ideas are candidates, not confirmed participation." .
  kb:access-question a ktype:Question ; rdfs:label "OPEN: what PDC access and uses are agreed?" ;
    kpred:asks-about kb:pdc-api ;
    dc:description "Confirm the current API instance/version, client authentication, permitted datasets, caching and AI uses with PDC. Public code establishes feasibility, not permission or a working integration." .
  kb:scope-question a ktype:Question ; rdfs:label "OPEN: what pilot can the requested budget deliver?" ;
    kpred:asks-about kb:pilot-evaluation ;
    dc:description "Choose a funding tier, duration, staffing and measurable community outcomes. Keep the initial exploration pilot deliverable even if live PDC access is delayed." .
}

src:example-guide {
  kb:humanity-pdc-example a ktype:Concept ; rdfs:label "Humanity AI × PDC × Reckons.AI" ;
    dc:description "A people-first story: use local AI to learn and research, then bring a grant opportunity and a grant seeker's knowledge together to inspect alignment. Sources are dated 2026-09-15; proposals and illustrative assessments are labelled at each node." ;
    kpred:includes kb:humanity-ai, kb:philanthropy-data-commons, kb:reckons-ai, kb:funding-hypothesis, kb:earlier-humanity-draft, kb:opportunity-graph, kb:seeker-graph, kb:alignment-graph ;
    kpred:has-story kb:humanity-pdc-story .
  kb:humanity-pdc-story a story:Story ; rdfs:label "Knowledge you control: local AI, learning and a grant alignment story" ;
    story:description "Nine steps from a person's notes to a sourced grant alignment. Includes the Humanity AI opportunity, the Reckons grant-seeker profile and a proposed PDC role. The assessment examples are authored, not automated verdicts." ;
    story:autoplay "false" ; story:pace "12" .
  kb:humanity-pdc-step-1 a story:Step ; story:partOf kb:humanity-pdc-story ; story:order 1 ;
    story:title "1. Start with knowledge you control" ; story:highlight kb:people-first-ai, kb:personal-notes, kb:reviewed-copy ; story:layout "force" ;
    story:content "A person starts with a voice note, a reading or an unfinished idea. Reckons keeps the original useful before extracting relationships. The aim is to put useful AI within people's reach while they keep control of their knowledge and decide what to share." .
  kb:humanity-pdc-step-2 a story:Step ; story:partOf kb:humanity-pdc-story ; story:order 2 ;
    story:title "2. Learn and research with local AI" ; story:highlight kb:local-learning, kb:local-research, kb:accessible-local-ai ; story:layout "force" ;
    story:content "Imagine asking a local model to explain your course notes or compare claims in your research. Follow its evidence, correct a mistaken connection and keep your own questions. Smaller models can be candidates for bounded tasks; larger models can help with complex synthesis. Useful access and learning gains must be tested on people's actual devices." .
  kb:humanity-pdc-step-3 a story:Step ; story:partOf kb:humanity-pdc-story ; story:order 3 ;
    story:title "3. Read the opportunity as a graph" ; story:highlight kb:opportunity-graph, kb:humanity-ai-call, kb:eligible-lead ; story:layout "force" ;
    story:content "For a concrete research task, open Humanity AI's call. Its graph separates what the funder asks for from our interpretation. Follow the source to check each requirement and the deadline. This is input A: the opportunity's terms, not an assumption that Reckons qualifies." .
  kb:humanity-pdc-step-4 a story:Step ; story:partOf kb:humanity-pdc-story ; story:order 4 ;
    story:title "4. Describe the grant seeker honestly" ; story:highlight kb:seeker-graph, kb:reckons-builder, kb:reckons-ai, kb:community-panel ; story:layout "force" ;
    story:content "Input B holds the seeker's purpose, experience, working tools and proposed outcomes. Here it records your Submittable PDC pilot experience, open-source Reckons and the local-AI vision. It also says what is missing: a confirmed eligible lead, participating community and agreed pilot. Experience and intent remain distinct from commitments." .
  kb:humanity-pdc-step-5 a story:Step ; story:partOf kb:humanity-pdc-story ; story:order 5 ;
    story:title "5. Bring the two graphs together" ; story:highlight kb:opportunity-graph, kb:seeker-graph, kb:merge-for-alignment, kb:alignment-graph ; story:layout "force" ;
    story:content "Review a proposed merge into a third working graph. Match shared concepts, preserve each statement's source and keep disagreements visible. Both input graphs stay intact. Reckons has entity-alignment tools; this combined example illustrates the grant workflow, whose single guided merge action remains to be built." .
  kb:humanity-pdc-step-6 a story:Step ; story:partOf kb:humanity-pdc-story ; story:order 6 ;
    story:title "6. Check alignment against evidence" ; story:highlight kb:alignment-potential, kb:alignment-eligibility, kb:alignment-community, kb:alignment-review ; story:layout "force" ;
    story:content "Inspect three illustrative findings: technical fit has some support; applicant eligibility is unknown; community authority is proposed but not demonstrated. A chosen model could draft these explanations, with a person checking every link. Similar words are not eligibility, and a missing fact becomes a question rather than a guessed answer." .
  kb:humanity-pdc-step-7 a story:Step ; story:partOf kb:humanity-pdc-story ; story:order 7 ;
    story:title "7. Extend the inquiry through PDC" ; story:highlight kb:philanthropy-data-commons, kb:pdc-explorer-proposal, kb:authorized-records, kb:gap-analysis ; story:layout "force" ;
    story:content "PDC could supply authorized records for a wider view of opportunities and complementary work. Reckons could help people explore those relationships and ask what they mean. Its public API documentation makes a client worth investigating; live access and the connector still need work. Restricted records must never be mistaken for nonexistent activity." .
  kb:humanity-pdc-step-8 a story:Step ; story:partOf kb:humanity-pdc-story ; story:order 8 ;
    story:title "8. Choose what leaves the personal graph" ; story:highlight kb:human-review, kb:organization-graph, kb:pdc-writeback, kb:public-release ; story:layout "force" ;
    story:content "Review an excerpt or application brief and its destination. Personal notes can feed an organizational graph through approved copies. PDC updates and public open data would require separate permissions and future integration. A model's suggestion does not authorize any transfer." .
  kb:humanity-pdc-step-9 a story:Step ; story:partOf kb:humanity-pdc-story ; story:order 9 ;
    story:title "9. Put community benefit to the test" ; story:highlight kb:community-panel, kb:pilot-evaluation, kb:funding-hypothesis ; story:layout "force" ;
    story:content "The funding case is a community-directed way to learn, research and coordinate with knowledge people control. Let participants choose the tasks and decisions. Compare manual work, smaller models and larger models; measure useful answers, corrections, effort and access on real devices. Resolve the open requirements before presenting the pilot as ready." .
}
