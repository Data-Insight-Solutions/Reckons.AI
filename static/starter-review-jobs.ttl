<urn:kbase:stmt/rex-2508d802ce1c691e>
    rdf:type rdf:Statement ;
    rdf:subject kb:rx-what-to-check ;
    rdf:predicate rdfs:comment ;
    rdf:object "Demonstrates F269.1 (every local job detailed in This device). THIS IS A FIXTURE, not this machine: invented jobs and made-up run records, generated by scripts/agent/queue-to-space.ts --device from fixture worker and done files. 1) Find the job nodes: each carries its state (running, queued, held with a reason, given-up). \"room-scan\" should be running, \"describe-entities\" queued and waiting on it, \"weekly-summary\" held, \"flaky-export\" given-up. 2) Open \"link-check\": it ran 26 times, so it should show its 20 newest runs as nodes and a count for the older six. 3) Open a failed run: it should show how it ended. The \"room-scan\" run that made a splat names its output id. 4) Weakness to know: the real This device space does not exist yet (F269), and nothing schedules this script, so the real device file is not here." ;
    meta:status "confirmed" ;
    meta:confidence "1"^^xsd:decimal ;
    meta:reviewMetadata "{\"version\":1,\"fields\":{\"sourceId\":\"review-example-jobs\",\"updatedAt\":1794301200000}}" ;
    prov:wasDerivedFrom src:review-example-jobs ;
    dc:created "2026-11-10T09:00:00.000Z"^^xsd:dateTime .

