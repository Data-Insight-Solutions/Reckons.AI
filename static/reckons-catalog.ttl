    dcterms:source "static/reckons-roadmap.ttl" .

graph:reckons-safety-log a void:Dataset ;
    dcterms:title "Safety attestation log" ;
    dcterms:type role:observed ;
    dcterms:source "static/reckons-safety-log.ttl" ;
    prov:wasGeneratedBy <urn:reckons:script/scripts/offline/safety-attestation.ts> .

graph:reckons-sets-spec a void:Dataset ;
    dcterms:title "Sets specification" ;
    dcterms:type role:proposed ;
    dcterms:source "static/reckons-sets-spec.ttl" .

graph:reckons-shipped a void:Dataset ;
    dcterms:title "Shipped work" ;
    dcterms:type role:archive ;
    dcterms:source "static/reckons-shipped.ttl" .

graph:reckons-standards a void:Dataset ;
    dcterms:title "Coding standards" ;
    dcterms:type role:reference ;
    dcterms:source "static/reckons-standards.ttl" .

graph:reckons-terminology a void:Dataset ;
    dcterms:title "Terminology" ;
    dcterms:type role:reference ;
    dcterms:source "static/reckons-terminology.ttl" .

graph:reckons-vocabulary a void:Dataset ;
    dcterms:title "Closed vocabularies (SKOS and SHACL)" ;
    dcterms:type role:reference ;
    dcterms:source "static/reckons-vocabulary.ttl" .

graph:starter-assets a void:Dataset ;
    dcterms:title "Starter: assets" ;
    dcterms:type role:starter ;
    dcterms:source "static/starter-assets.ttl" .

graph:starter-everyday a void:Dataset ;
    dcterms:title "Starter: everyday" ;
