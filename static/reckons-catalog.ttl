graph:starter-quickstart a void:Dataset ;
    dcterms:title "Starter: quickstart" ;
    dcterms:type role:starter ;
    dcterms:source "static/starter-quickstart.ttl" .

graph:starter-turtles a void:Dataset ;
    dcterms:title "Starter: turtles" ;
    dcterms:type role:starter ;
    dcterms:source "static/starter-turtles.ttl" .

graph:starter-visual-review a void:Dataset ;
    dcterms:title "Starter: visual review" ;
