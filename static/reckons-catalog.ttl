    dcterms:type role:design ;
    dcterms:source "static/website.ttl" .

graph:website-status a void:Dataset ;
    dcterms:title "Docs site as observed" ;
    dcterms:type role:observed ;
    dcterms:source "static/website-status.ttl" ;
