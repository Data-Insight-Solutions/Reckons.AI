## Review 2026-11-10 — a hub of three small example spaces, one per feature merged that day.
## Hand-written. The three spaces are generated by scripts/starter/build-review-examples.ts.
## Everything is SYNTHETIC: invented names, a made-up garden club, a made-up workshop, fixture job records.
## Each leap below is an app path (src/lib/rdf/kb-leap.ts, kind "app"): the About page reads ?example=<id>
## and opens that example as its own space, keeping each fact's review status.

@prefix rdf:   <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .
@prefix ktype: <urn:kbase:type/> .
@prefix kb:    <urn:kbase:concept/> .
@prefix p:     <urn:kbase:predicate/> .
@prefix hnav:  <urn:reckons:nav/> .
@prefix rev:   <urn:reckons:review/2026-11-10/> .

rev:hub rdf:type ktype:Concept ;
    rdfs:label "Review 2026-11-10" ;
    rdfs:comment "Three small example spaces for features merged on 2026-11-10, so each can be looked at in the running app. Select a node below and use its leap arrow to open that space as its own space. Each space has a node called \"What to check\" with the steps. All of it is invented; nothing here describes a real person, place or machine." ;
    hnav:order "0"^^xsd:integer ;
    hnav:layer "0"^^xsd:integer ;
    p:has rev:proposals, rev:scan, rev:jobs .

rev:proposals rdf:type ktype:Concept ;
    rdfs:label "Proposals and questions" ;
    rdfs:comment "Demonstrates F223.9, F223.10 and F223.11: confirmed facts, pending facts, the two options of one proposal, and open questions, drawn differently and filterable. Opens as its own space." ;
    hnav:order "1"^^xsd:integer ;
    hnav:layer "1"^^xsd:integer ;
    hnav:next rev:scan ;
    <urn:reckons:leap>        "/about?example=review-proposals" ;
    <urn:reckons:leap/label>  "Open: Proposals and questions" .

rev:scan rdf:type ktype:Concept ;
    rdfs:label "A scan arrives" ;
    rdfs:comment "Demonstrates F58.9.20: a capture and a place, a splat attached and linked to its capture, and a second splat that arrived with no link, so the question \"Which capture is this a scan of?\" is open. Opens as its own space." ;
    hnav:order "2"^^xsd:integer ;
    hnav:layer "1"^^xsd:integer ;
    hnav:prev rev:proposals ;
    hnav:next rev:jobs ;
    <urn:reckons:leap>        "/about?example=review-scan" ;
    <urn:reckons:leap/label>  "Open: A scan arrives" .

rev:jobs rdf:type ktype:Concept ;
    rdfs:label "Job records" ;
    rdfs:comment "Demonstrates F269.1: local jobs in several states (running, queued, held, given up) and one job with more than 20 runs. A fixture, not this machine. Opens as its own space." ;
    hnav:order "3"^^xsd:integer ;
    hnav:layer "1"^^xsd:integer ;
    hnav:prev rev:scan ;
    <urn:reckons:leap>        "/about?example=review-jobs" ;
    <urn:reckons:leap/label>  "Open: Job records" .
