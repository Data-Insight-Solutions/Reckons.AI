@prefix rdf:    <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:   <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos:   <http://www.w3.org/2004/02/skos/core#> .
@prefix ktype:  <urn:kbase:type/> .
@prefix kpred:  <urn:kbase:predicate/> .
@prefix kb:     <urn:kbase:concept/> .
@prefix ci:     <urn:reckons:ci/> .
@prefix job:    <urn:reckons:job/> .

## ---------------------------------------------------------------------------
## GENERATED by scripts/ci-graph.ts from .github/workflows/*.yml, .github/ruleset-main.json,
## scripts/offline/jobs.json and the has-file / tested-by links in the roadmap and production
## graphs. Do not hand-edit: run `npx tsx scripts/ci-graph.ts`. The script tier checks it.
##
## The YAML is what GitHub executes; this is what can be ASKED of it (F33.2): what stops a
## bad merge to main, which checks only advise, and which roadmap features each check guards.
## ---------------------------------------------------------------------------

<urn:reckons:kb> <urn:reckons:meta/kbStableId> "a1b2c3d4-e5f6-4a0f-b00f-000000000015" .

ci:workflow-ci rdf:type ktype:CiWorkflow ;
    rdfs:label "CI" ;
    kpred:has-file ".github/workflows/ci.yml" ;
    kpred:runs-on-event "push (main, staging, dev)" ;
    kpred:runs-on-event "pull_request (main, staging, dev)" ;
    kpred:check-count "8" .

ci:workflow-codeql rdf:type ktype:CiWorkflow ;
    rdfs:label "CodeQL" ;
    kpred:has-file ".github/workflows/codeql.yml" ;
    kpred:runs-on-event "push (main, staging, dev)" ;
    kpred:runs-on-event "pull_request (main, staging, dev)" ;
    kpred:runs-on-event "schedule" ;
    kpred:check-count "1" .

ci:workflow-dependency-audit rdf:type ktype:CiWorkflow ;
    rdfs:label "Dependency audit" ;
    kpred:has-file ".github/workflows/dependency-audit.yml" ;
    kpred:runs-on-event "pull_request (dev, staging, main)" ;
    kpred:runs-on-event "push (dev, staging, main)" ;
    kpred:runs-on-event "schedule" ;
    kpred:runs-on-event "workflow_dispatch" ;
    kpred:check-count "3" .

ci:workflow-extension rdf:type ktype:CiWorkflow ;
    rdfs:label "Extension Build & Sign" ;
    kpred:has-file ".github/workflows/extension.yml" ;
    kpred:runs-on-event "pull_request (dev)" ;
    kpred:runs-on-event "push (main)" ;
    kpred:runs-on-event "workflow_dispatch" ;
    kpred:check-count "1" .

ci:workflow-kb-watch rdf:type ktype:CiWorkflow ;
    rdfs:label "Reckons.AI Graph Alignment" ;
    kpred:has-file ".github/workflows/kb-watch.yml" ;
    kpred:runs-on-event "push (main, staging, dev)" ;
    kpred:runs-on-event "pull_request (main, staging, dev)" ;
    kpred:check-count "1" .

ci:workflow-safety-attestation rdf:type ktype:CiWorkflow ;
    rdfs:label "Safety Attestation" ;
    kpred:has-file ".github/workflows/safety-attestation.yml" ;
    kpred:runs-on-event "schedule" ;
    kpred:runs-on-event "push (main)" ;
    kpred:runs-on-event "pull_request (main, staging, dev)" ;
    kpred:runs-on-event "workflow_dispatch" ;
    kpred:check-count "1" .

ci:check-analyze-javascript-typescript rdf:type ktype:CiCheck ;
    rdfs:label "Analyze (javascript-typescript)" ;
    kpred:part-of ci:workflow-codeql ;
    kpred:job-id "analyze" ;
    kpred:can-block-merge "false" ;
    skos:definition "Advisory: no ruleset requires it, so it reports but cannot stop a merge." .

ci:check-attest rdf:type ktype:CiCheck ;
    rdfs:label "attest" ;
    kpred:part-of ci:workflow-safety-attestation ;
    kpred:job-id "attest" ;
    kpred:can-block-merge "false" ;
    kpred:runs-script "scripts/offline/safety-attestation.ts" ;
    skos:definition "Advisory: no ruleset requires it, so it reports but cannot stop a merge." .

ci:check-build-sign-release rdf:type ktype:CiCheck ;
    rdfs:label "Build, sign & release" ;
    kpred:part-of ci:workflow-extension ;
    kpred:job-id "build-and-sign" ;
    kpred:can-block-merge "false" ;
    kpred:runs-script "scripts/extension/build-firefox.ts" ;
    kpred:runs-script "scripts/offline/vite-secret-guard.ts" ;
    skos:definition "Advisory: no ruleset requires it, so it reports but cannot stop a merge." .

ci:check-dependencies rdf:type ktype:CiCheck ;
    rdfs:label "Dependencies (.)" ;
    kpred:part-of ci:workflow-dependency-audit ;
    kpred:job-id "audit" ;
    kpred:can-block-merge "false" ;
    skos:definition "Advisory: no ruleset requires it, so it reports but cannot stop a merge." .

ci:check-dependencies-cli rdf:type ktype:CiCheck ;
    rdfs:label "Dependencies (cli)" ;
    kpred:part-of ci:workflow-dependency-audit ;
    kpred:job-id "audit" ;
    kpred:can-block-merge "false" ;
    skos:definition "Advisory: no ruleset requires it, so it reports but cannot stop a merge." .

ci:check-dependencies-mcp-server rdf:type ktype:CiCheck ;
    rdfs:label "Dependencies (mcp-server)" ;
    kpred:part-of ci:workflow-dependency-audit ;
    kpred:job-id "audit" ;
    kpred:can-block-merge "false" ;
    skos:definition "Advisory: no ruleset requires it, so it reports but cannot stop a merge." .

ci:check-deploy-gate-graph-render-smoke-production-build rdf:type ktype:CiCheck ;
    rdfs:label "Deploy Gate — Graph Render Smoke (Production Build)" ;
    kpred:part-of ci:workflow-ci ;
    kpred:job-id "smoke" ;
    kpred:can-block-merge "true" ;
    kpred:required-by ci:ruleset-main-merge-protection ;
    kpred:depends-on ci:check-type-check-unit-tests-build ;
    kpred:runs-script "scripts/visual-smoke-gate.ts" ;
    skos:definition "Required by Main merge protection: a merge to main waits for it to pass." .

ci:check-e2e-desktop-chrome rdf:type ktype:CiCheck ;
    rdfs:label "E2E (Desktop Chrome)" ;
    kpred:part-of ci:workflow-ci ;
    kpred:job-id "e2e" ;
    kpred:can-block-merge "true" ;
    kpred:required-by ci:ruleset-main-merge-protection ;
    kpred:depends-on ci:check-type-check-unit-tests-build ;
    skos:definition "Required by Main merge protection: a merge to main waits for it to pass." .

ci:check-mcp-server-build-tests rdf:type ktype:CiCheck ;
    rdfs:label "MCP server (build + tests)" ;
    kpred:part-of ci:workflow-ci ;
    kpred:job-id "mcp" ;
    kpred:can-block-merge "true" ;
    kpred:required-by ci:ruleset-main-merge-protection ;
    skos:definition "Required by Main merge protection: a merge to main waits for it to pass." .

ci:check-promotion-gate-staging-main rdf:type ktype:CiCheck ;
    rdfs:label "Promotion gate (staging → main)" ;
    kpred:part-of ci:workflow-ci ;
    kpred:job-id "promotion-gate" ;
    kpred:can-block-merge "true" ;
    kpred:required-by ci:ruleset-main-merge-protection ;
    kpred:runs-when "github.event_name == 'pull_request'" ;
    kpred:runs-script "scripts/offline/promotion-gate.ts" ;
    skos:definition "Required by Main merge protection: a merge to main waits for it to pass." .

ci:check-reckons-ai-graph-alignment-check rdf:type ktype:CiCheck ;
    rdfs:label "Reckons.AI Graph Alignment Check" ;
    kpred:part-of ci:workflow-kb-watch ;
    kpred:job-id "alignment" ;
    kpred:can-block-merge "true" ;
    kpred:required-by ci:ruleset-main-merge-protection ;
    kpred:runs-script "scripts/docs-pages.ts" ;
    kpred:runs-script "scripts/kb-align.ts" ;
    kpred:runs-script "scripts/kb-snapshot.ts" ;
    kpred:runs-script "scripts/md-align.ts" ;
    kpred:runs-script "scripts/offline/vite-secret-guard.ts" ;
    kpred:runs-script "scripts/setup-reckons-workspace.sh" ;
    kpred:guards kb:derived-prose ;
    kpred:guards kb:why-reckons-positioning ;
    skos:definition "Required by Main merge protection: a merge to main waits for it to pass." .

ci:check-release-notes-next-version rdf:type ktype:CiCheck ;
    rdfs:label "Release notes (next version)" ;
    kpred:part-of ci:workflow-ci ;
    kpred:job-id "release-notes" ;
    kpred:can-block-merge "false" ;
    kpred:runs-when "(github.event_name == 'push' && github.ref == 'refs/heads/staging') || (github.event_name == 'pull_request' && github.base_ref == 'main')" ;
    kpred:runs-script "scripts/offline/release-notes.ts" ;
    kpred:guards kb:release-notes ;
    skos:definition "Advisory: no ruleset requires it, so it reports but cannot stop a merge." .

ci:check-script-tier-f74-3-deterministic-zero-tokens rdf:type ktype:CiCheck ;
    rdfs:label "Script tier (F74.3 — deterministic, zero tokens)" ;
    kpred:part-of ci:workflow-ci ;
    kpred:job-id "script-tier" ;
    kpred:can-block-merge "true" ;
    kpred:required-by ci:ruleset-main-merge-protection ;
    kpred:runs-script "scripts/offline/run-all.ts" ;
    kpred:enforces job:published-graph-guard ;
    kpred:enforces job:version-align ;
    kpred:enforces job:codebase-coverage ;
    kpred:enforces job:term-ratchet ;
    kpred:guards kb:code-graph-edges ;
    kpred:guards kb:terminology-maintenance ;
    kpred:guards kb:terminology-ontology ;
    skos:definition "Required by Main merge protection: a merge to main waits for it to pass." .

ci:check-type-check-unit-tests-build rdf:type ktype:CiCheck ;
    rdfs:label "Type check + Unit tests + Build" ;
    kpred:part-of ci:workflow-ci ;
    kpred:job-id "check" ;
    kpred:can-block-merge "true" ;
    kpred:required-by ci:ruleset-main-merge-protection ;
    kpred:runs-script "scripts/align.ts" ;
    kpred:runs-script "scripts/offline/build-guard.ts" ;
    kpred:runs-script "scripts/offline/secret-scan.ts" ;
    kpred:runs-script "scripts/offline/vite-secret-guard.ts" ;
    skos:definition "Required by Main merge protection: a merge to main waits for it to pass." .

ci:check-visual-chromium rdf:type ktype:CiCheck ;
    rdfs:label "Visual (Chromium)" ;
    kpred:part-of ci:workflow-ci ;
    kpred:job-id "visual" ;
    kpred:can-block-merge "true" ;
    kpred:required-by ci:ruleset-main-merge-protection ;
    kpred:depends-on ci:check-type-check-unit-tests-build ;
    skos:definition "Required by Main merge protection: a merge to main waits for it to pass." .

ci:ruleset-main-merge-protection rdf:type ktype:CiRuleset ;
    rdfs:label "Main merge protection" ;
    kpred:has-file ".github/ruleset-main.json" ;
    kpred:enforcement "active" ;
    kpred:protects-branch "main" ;
    kpred:required-check-count "8" .

ci:required rdf:type skos:Collection ;
    skos:prefLabel "Checks that can stop a merge" ;
    skos:definition "8 of 15 checks are required by a ruleset. Only branches a ruleset names are protected: main." ;
    skos:member ci:check-deploy-gate-graph-render-smoke-production-build, ci:check-e2e-desktop-chrome, ci:check-mcp-server-build-tests, ci:check-promotion-gate-staging-main, ci:check-reckons-ai-graph-alignment-check, ci:check-script-tier-f74-3-deterministic-zero-tokens, ci:check-type-check-unit-tests-build, ci:check-visual-chromium .

ci:advisory rdf:type skos:Collection ;
    skos:prefLabel "Checks that only advise" ;
    skos:definition "7 checks run and report, but no ruleset requires them, so a failure cannot stop a merge." ;
    skos:member ci:check-analyze-javascript-typescript, ci:check-attest, ci:check-build-sign-release, ci:check-dependencies, ci:check-dependencies-cli, ci:check-dependencies-mcp-server, ci:check-release-notes-next-version .
