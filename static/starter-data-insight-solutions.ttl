<urn:kbase:stmt/dis-23fa918bbd8ed444>
    rdf:type rdf:Statement ;
    rdf:subject kb:dis-story-step-4 ;
    rdf:predicate <urn:reckons:story/content> ;
    rdf:object "The line at the foot of every page, \"© 2026 Data Insight Solutions · Ava, Missouri\", is written once, in the site's settings, and the build puts it on all 15 pages and posts. Change it there once and the next build changes every page; nobody has to find and edit 15 copies. The lit node is that one fact, and it links to each page that shows it." ;
    meta:status "confirmed" ;
    meta:confidence "1"^^xsd:decimal ;
    meta:reviewMetadata "{\"version\":1,\"fields\":{\"sourceId\":\"dis-website\",\"updatedAt\":1794387600000}}" ;
