<urn:kbase:stmt/dis-c9d6fb112ec3ab1f>
    rdf:type rdf:Statement ;
    rdf:subject kb:dis-story-step-5 ;
    rdf:predicate <urn:reckons:story/content> ;
    rdf:object "Some things stop being true on a known day. 1 fact on this site carries an end date: AWS Certified Solutions Architect – Associate, issued December 2024, valid to December 2027 (valid until 2027-12-01). On every build the check lists anything past its date, warns 60 days ahead, and refuses to publish a page that states an expired fact, naming the fact and the page." ;
    meta:status "confirmed" ;
    meta:confidence "1"^^xsd:decimal ;
    meta:reviewMetadata "{\"version\":1,\"fields\":{\"sourceId\":\"dis-website\",\"updatedAt\":1794387600000}}" ;
