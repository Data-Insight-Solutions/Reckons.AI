kb:dis-story
    rdf:type <urn:reckons:story/Story> ;
    rdfs:label "How this website was made" ;
    <urn:reckons:story/description> "How the content, the pages and the checks behind this website came together, in six short steps." ;
    <urn:reckons:story/autoplay> "false" .

kb:dis-story-step-1
    rdf:type <urn:reckons:story/Step> ;
    <urn:reckons:story/partOf> kb:dis-story ;
    <urn:reckons:story/order> "1"^^xsd:integer ;
    <urn:reckons:story/title> "Where the content came from" ;
    <urn:reckons:story/content> "This example is the published website of Data Insight Solutions, read in as sources: 4 pages and 11 blog posts, 15 in all. The owner also kept private notes, which were used to check claims on the site but are not part of this example, and no content from them is included here." ;
    <urn:reckons:story/highlight> kb:dis-site ;
    <urn:reckons:story/highlight> kb:dis-blog .

kb:dis-story-step-2
    rdf:type <urn:reckons:story/Step> ;
    <urn:reckons:story/partOf> kb:dis-story ;
    <urn:reckons:story/order> "2"^^xsd:integer ;
    <urn:reckons:story/title> "Who is behind the site" ;
    <urn:reckons:story/content> "Matthew Roe is the owner-operator of Data Insight Solutions LLC, formed in 2023, in Ava, Missouri. The About page describes the work as solutions architect for DAM and AI systems integrator. From the About and Services pages this example holds 4 services, 6 credentials, 2 recognitions, each one marked with the page that states it. Open the person or the company to see them connected to the services, the posts that cover them and the dated credential." ;
    <urn:reckons:story/highlight> kb:dis-person-matthew-roe ;
    <urn:reckons:story/highlight> kb:dis-llc ;
    <urn:reckons:story/highlight> kb:dis-place-ava-missouri .

kb:dis-story-step-3
    rdf:type <urn:reckons:story/Step> ;
    <urn:reckons:story/partOf> kb:dis-story ;
    <urn:reckons:story/order> "3"^^xsd:integer ;
    <urn:reckons:story/title> "Pages made from one set of facts" ;
    <urn:reckons:story/content> "Each page is one entry here with its title, address and place in the site: 4 pages and 11 posts. The website builder reads the same page files this example was made from and turns them into the pages visitors read, with one shared set of settings for the menu, the footer and the look." ;
    <urn:reckons:story/highlight> kb:dis-page-about ;
    <urn:reckons:story/highlight> kb:dis-page-contact ;
    <urn:reckons:story/highlight> kb:dis-page-home ;
    <urn:reckons:story/highlight> kb:dis-page-services .

kb:dis-story-step-4
    rdf:type <urn:reckons:story/Step> ;
    <urn:reckons:story/partOf> kb:dis-story ;
    <urn:reckons:story/order> "4"^^xsd:integer ;
    <urn:reckons:story/title> "One fact, stated on many pages" ;
    <urn:reckons:story/content> "The line at the foot of every page, \"© 2026 Data Insight Solutions · Ava, Missouri\", is written once, in the site's settings, and the build puts it on all 15 pages and posts. Change it there once and the next build changes every page; nobody has to find and edit 15 copies. The lit node is that one fact, and it links to each page that shows it." ;
    <urn:reckons:story/highlight> kb:dis-shared-footer .

kb:dis-story-step-5
    rdf:type <urn:reckons:story/Step> ;
    <urn:reckons:story/partOf> kb:dis-story ;
    <urn:reckons:story/order> "5"^^xsd:integer ;
    <urn:reckons:story/title> "Facts that expire" ;
    <urn:reckons:story/content> "Some things stop being true on a known day. 1 fact on this site carries an end date: AWS Certified Solutions Architect – Associate, issued December 2024, valid to December 2027 (valid until 2027-12-01). On every build the check lists anything past its date, warns 60 days ahead, and refuses to publish a page that states an expired fact, naming the fact and the page." ;
    <urn:reckons:story/highlight> kb:dis-fact-118e57793700 .

kb:dis-story-step-6
    rdf:type <urn:reckons:story/Step> ;
    <urn:reckons:story/partOf> kb:dis-story ;
    <urn:reckons:story/order> "6"^^xsd:integer ;
    <urn:reckons:story/title> "The live website" ;
    <urn:reckons:story/content> "The result is the live website, 15 pages and posts built from this one source. The site node is lit; its link opens the real website, so you can compare what you have just walked through with what a visitor sees." ;
    <urn:reckons:story/highlight> kb:dis-site .

