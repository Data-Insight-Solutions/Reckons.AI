legacy-peer-deps=true
# kokoro-js pulls an older onnxruntime-node (1.21.0) whose install script downloads an optional CUDA
# build from GitHub releases; that asset now answers 404 (checked 2026-11-17), so every npm ci on
# Linux failed: CI, Cloudflare Pages and local worktrees alike. The workflows' ONNXRUNTIME_NODE_INSTALL
# env var covers only the newer 1.24; Cloudflare builds never see workflow env. 1.21 reads this npm
# config key (npm_config_onnxruntime_node_install_cuda). The CPU binary ships bundled; the app uses
# onnxruntime-web in the browser, so nothing loses a capability.
onnxruntime-node-install-cuda=skip
