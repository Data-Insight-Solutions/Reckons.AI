diff --git a/src/lib/integrations/llm/route.ts b/src/lib/integrations/llm/route.ts
--- a/src/lib/integrations/llm/route.ts
+++ b/src/lib/integrations/llm/route.ts
@@ -8,4 +8,5 @@ export function evidenceProvider(s: Settings): string {
